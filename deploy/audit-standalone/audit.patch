diff --git a/backend/internal/audit/api.go b/backend/internal/audit/api.go
new file mode 100644
index 000000000..51de0794e
--- /dev/null
+++ b/backend/internal/audit/api.go
@@ -0,0 +1,294 @@
+package audit
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"path"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/gin-gonic/gin"
+)
+
+// UsageRef 是用量记录中与归档关联的字段（由装配层从数据库读取）。
+type UsageRef struct {
+	ID        int64     `json:"id"`
+	RequestID string    `json:"request_id"`
+	APIKeyID  int64     `json:"api_key_id"`
+	AccountID int64     `json:"account_id"`
+	UserID    int64     `json:"user_id"`
+	CreatedAt time.Time `json:"created_at"`
+}
+
+// UsageLookup 按 ID 读取用量记录；不存在时返回 (nil, nil)。
+type UsageLookup func(ctx context.Context, id int64) (*UsageRef, error)
+
+// Candidate 是一条候选归档。
+type Candidate struct {
+	Ref         string       `json:"ref"`
+	Entries     []IndexEntry `json:"entries"`
+	Score       int          `json:"score"`
+	MatchReason []string     `json:"match_reason"`
+}
+
+// RegisterRoutes 注册管理端归档接口（调用方负责挂在管理员鉴权之后）。
+func RegisterRoutes(g *gin.RouterGroup, lookup UsageLookup) {
+	a := g.Group("/audit-archive")
+	a.GET("/status", handleStatus)
+	a.GET("/usage/:id", func(c *gin.Context) { handleUsage(c, lookup) })
+	a.GET("/lookup", handleLookup)
+	a.GET("/archive", handleArchive)
+	a.GET("/body", handleBody)
+}
+
+func storeOr503(c *gin.Context) *Store {
+	s := Default()
+	if s == nil {
+		response.ErrorWithDetails(c, http.StatusServiceUnavailable, "request archive is disabled", "AUDIT_ARCHIVE_DISABLED", nil)
+		return nil
+	}
+	return s
+}
+
+func handleStatus(c *gin.Context) {
+	s := Default()
+	if s == nil {
+		response.Success(c, gin.H{"enabled": false})
+		return
+	}
+	response.Success(c, gin.H{"enabled": true, "root": s.Root(), "stats": s.StatsSnapshot(), "display_body_limit": s.cfg.DisplayBodyLimit})
+}
+
+// lookupKeys 用量 request_id 通常为 "client:<客户端请求ID>"；两者都查。
+func lookupKeys(id string) []string {
+	id = strings.TrimSpace(id)
+	keys := []string{id}
+	if rest, ok := strings.CutPrefix(id, "client:"); ok && rest != "" {
+		keys = append(keys, rest)
+	}
+	return keys
+}
+
+// Resolve 汇总候选归档并按关联证据打分。
+func (s *Store) Resolve(u *UsageRef) ([]Candidate, error) {
+	byRef := map[string]*Candidate{}
+	var order []string
+	for _, key := range lookupKeys(u.RequestID) {
+		entries, err := s.Lookup(key)
+		if err != nil {
+			return nil, err
+		}
+		for _, e := range entries {
+			cand, ok := byRef[e.Ref]
+			if !ok {
+				cand = &Candidate{Ref: e.Ref}
+				byRef[e.Ref] = cand
+				order = append(order, e.Ref)
+			}
+			cand.Entries = append(cand.Entries, e)
+		}
+	}
+	out := make([]Candidate, 0, len(order))
+	for _, ref := range order {
+		cand := byRef[ref]
+		reasons := map[string]bool{}
+		for _, e := range cand.Entries {
+			if e.Via == "usage_callback" && e.UsageRequestID == u.RequestID {
+				reasons["usage_callback_request_id"] = true
+				if u.APIKeyID != 0 && e.APIKeyID == u.APIKeyID {
+					reasons["api_key_id"] = true
+				}
+				if u.AccountID != 0 && e.AccountID == u.AccountID {
+					reasons["account_id"] = true
+				}
+			}
+			if e.Via == "client_request_id" {
+				reasons["client_request_id"] = true
+				if !u.CreatedAt.IsZero() {
+					d := u.CreatedAt.Sub(e.Time)
+					if d >= -time.Minute && d <= 6*time.Hour {
+						reasons["time_window"] = true
+					}
+				}
+			}
+		}
+		for r := range reasons {
+			cand.MatchReason = append(cand.MatchReason, r)
+			cand.Score++
+			if r == "usage_callback_request_id" {
+				cand.Score += 2
+			}
+		}
+		out = append(out, *cand)
+	}
+	return out, nil
+}
+
+func handleUsage(c *gin.Context, lookup UsageLookup) {
+	s := storeOr503(c)
+	if s == nil {
+		return
+	}
+	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || id <= 0 {
+		response.BadRequest(c, "invalid usage id")
+		return
+	}
+	if lookup == nil {
+		response.InternalError(c, "usage lookup not configured")
+		return
+	}
+	u, err := lookup(c.Request.Context(), id)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	if u == nil {
+		response.ErrorWithDetails(c, http.StatusNotFound, "usage record not found", "USAGE_NOT_FOUND", nil)
+		return
+	}
+	cands, err := s.Resolve(u)
+	if err != nil {
+		response.InternalError(c, "archive index read failed: "+err.Error())
+		return
+	}
+	result := gin.H{"usage": u, "candidates": cands}
+	chosen := strings.TrimSpace(c.Query("ref"))
+	switch {
+	case chosen != "":
+		found := false
+		for _, cand := range cands {
+			found = found || cand.Ref == chosen
+		}
+		if !found {
+			response.ErrorWithDetails(c, http.StatusBadRequest, "ref does not belong to this usage record", "AUDIT_REF_MISMATCH", nil)
+			return
+		}
+		result["resolution"] = "chosen"
+	case len(cands) == 0:
+		result["resolution"] = "not_found"
+		response.Success(c, result)
+		return
+	case len(cands) == 1:
+		chosen = cands[0].Ref
+		result["resolution"] = "unique"
+	default:
+		best, tie := -1, false
+		for i, cand := range cands {
+			if best < 0 || cand.Score > cands[best].Score {
+				best, tie = i, false
+			} else if cand.Score == cands[best].Score {
+				tie = true
+			}
+		}
+		if tie {
+			result["resolution"] = "ambiguous"
+			response.Success(c, result)
+			return
+		}
+		chosen = cands[best].Ref
+		result["resolution"] = "best_match_with_alternatives"
+	}
+	av, err := s.ReadArchive(chosen)
+	if err != nil {
+		response.InternalError(c, err.Error())
+		return
+	}
+	result["ref"] = chosen
+	result["archive"] = av
+	response.Success(c, result)
+}
+
+func handleLookup(c *gin.Context) {
+	s := storeOr503(c)
+	if s == nil {
+		return
+	}
+	id := strings.TrimSpace(c.Query("request_id"))
+	if id == "" {
+		response.BadRequest(c, "request_id is required")
+		return
+	}
+	cands, err := s.Resolve(&UsageRef{RequestID: id})
+	if err != nil {
+		response.InternalError(c, err.Error())
+		return
+	}
+	response.Success(c, gin.H{"candidates": cands})
+}
+
+func handleArchive(c *gin.Context) {
+	s := storeOr503(c)
+	if s == nil {
+		return
+	}
+	ref := c.Query("ref")
+	if !ValidRef(ref) {
+		response.BadRequest(c, "invalid ref")
+		return
+	}
+	av, err := s.ReadArchive(ref)
+	if err != nil {
+		response.InternalError(c, err.Error())
+		return
+	}
+	response.Success(c, av)
+}
+
+// handleBody 下载某段正文：decode=0 为原始字节（与 SHA256 头一致），
+// decode=1 按 Content-Encoding 在内存中流式解码。传输压缩交给前置 Nginx 协商。
+func handleBody(c *gin.Context) {
+	s := storeOr503(c)
+	if s == nil {
+		return
+	}
+	ref, kind := c.Query("ref"), c.Query("kind")
+	index, err := strconv.Atoi(c.DefaultQuery("index", "0"))
+	if err != nil || index < 0 {
+		response.BadRequest(c, "invalid index")
+		return
+	}
+	if _, err := s.FilePath(ref, kind); err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	decode := c.Query("decode") == "1"
+	started := false
+	_, err = s.StreamBody(c.Writer, ref, kind, index, decode, func(info BodyInfo) {
+		started = true
+		h := info.Header
+		name := fmt.Sprintf("%s-%s-%d.bin", path.Base(ref), kind, index)
+		c.Header("Content-Type", "application/octet-stream")
+		c.Header("Content-Disposition", fmt.Sprintf("attachment; filename=%q", name))
+		c.Header("X-Content-Type-Options", "nosniff")
+		c.Header("Cache-Control", "private, no-store")
+		if ct := headerValue(h.Header, "Content-Type"); ct != "" {
+			c.Header("X-Archive-Original-Content-Type", ct)
+		}
+		if enc := headerValue(h.Header, "Content-Encoding"); enc != "" {
+			c.Header("X-Archive-Content-Encoding", enc)
+		}
+		if !decode {
+			c.Header("X-Archive-Body-SHA256", info.SHA256)
+			c.Header("X-Archive-Body-Bytes", strconv.FormatInt(info.Bytes, 10))
+			c.Header("X-Archive-Intact", strconv.FormatBool(info.Intact))
+		}
+		if info.End != nil {
+			c.Header("X-Archive-Complete", strconv.FormatBool(info.End.Complete))
+		}
+		c.Status(http.StatusOK)
+	})
+	if err != nil && !started {
+		if errors.Is(err, errSectionNotFound) {
+			response.NotFound(c, err.Error())
+			return
+		}
+		response.NotFound(c, "archive body unavailable: "+err.Error())
+	}
+}
+
+var errSectionNotFound = errors.New("audit: section not found")
diff --git a/backend/internal/audit/archive.go b/backend/internal/audit/archive.go
new file mode 100644
index 000000000..df7175415
--- /dev/null
+++ b/backend/internal/audit/archive.go
@@ -0,0 +1,370 @@
+package audit
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"github.com/cespare/xxhash/v2"
+)
+
+// ArchiveView 是一次客户端请求的完整归档视图（四份文件 + 调度尝试汇总）。
+type ArchiveView struct {
+	Ref      string         `json:"ref"`
+	Files    []*FileView    `json:"files"`
+	Summary  map[string]any `json:"summary"`
+	Attempts []AttemptView  `json:"attempts"`
+	// Status: complete / incomplete / in_progress / missing
+	Status string   `json:"status"`
+	Issues []string `json:"issues,omitempty"`
+}
+
+// AttemptView 汇总一次上游调度尝试。
+type AttemptView struct {
+	Seq        int    `json:"seq"`
+	AccountID  any    `json:"account_id,omitempty"`
+	Method     string `json:"method,omitempty"`
+	URL        string `json:"url,omitempty"`
+	Transport  string `json:"transport,omitempty"`
+	Status     int    `json:"status,omitempty"`
+	SpanID     any    `json:"span_id,omitempty"`
+	Error      string `json:"error,omitempty"`
+	Complete   bool   `json:"complete"`
+	WSReused   bool   `json:"ws_reused,omitempty"`
+	RequestIdx []int  `json:"request_sections"`
+	RespIdx    []int  `json:"response_sections"`
+}
+
+// ReadArchive 读取并解析某个归档引用下的四份文件。
+func (s *Store) ReadArchive(ref string) (*ArchiveView, error) {
+	if !ValidRef(ref) {
+		return nil, errors.New("audit: invalid archive ref")
+	}
+	av := &ArchiveView{Ref: ref, Summary: map[string]any{}}
+	limit := s.cfg.DisplayBodyLimit
+	if limit <= 0 {
+		limit = DefaultConfig().DisplayBodyLimit
+	}
+	byKind := map[string]*FileView{}
+	missing := 0
+	for _, kind := range Kinds {
+		p, err := s.FilePath(ref, kind)
+		if err != nil {
+			return nil, err
+		}
+		fv := ReadFile(p, kind, limit)
+		av.Files = append(av.Files, fv)
+		byKind[kind] = fv
+		if fv.Status == "missing" {
+			missing++
+		}
+	}
+	if missing == len(Kinds) {
+		av.Status = "missing"
+		return av, nil
+	}
+	s.postProcessWS(byKind)
+	av.Attempts = buildAttempts(byKind[KindUpstreamRequest], byKind[KindUpstreamResponse])
+
+	// 汇总与完整性判断
+	if cr := byKind[KindClientRequest]; len(cr.Sections) > 0 {
+		h := cr.Sections[0].Header
+		av.Summary["method"] = h.Method
+		av.Summary["url"] = h.URL
+		av.Summary["transport"] = h.Transport
+		av.Summary["started_at"] = h.Time
+		for k, v := range h.Meta {
+			av.Summary[k] = v
+		}
+	}
+	if cw := byKind[KindClientResponse]; len(cw.Sections) > 0 {
+		sec := cw.Sections[0]
+		av.Summary["client_status"] = sec.Header.Status
+		if sec.End != nil {
+			for k, v := range sec.End.Meta {
+				av.Summary[k] = v
+			}
+			av.Summary["finished_at"] = sec.End.Time
+		}
+		av.Summary["usage_notes"] = cw.Notes
+	}
+	av.Status = "complete"
+	for _, fv := range av.Files {
+		switch fv.Status {
+		case "empty":
+			av.Status = "in_progress"
+			av.Issues = append(av.Issues, fmt.Sprintf("%s: not yet flushed (request in progress, or process exited before flush)", fv.Kind))
+		case "ok":
+		default:
+			if av.Status == "complete" {
+				av.Status = "incomplete"
+			}
+			av.Issues = append(av.Issues, fmt.Sprintf("%s: %s %s", fv.Kind, fv.Status, fv.Error))
+		}
+		for _, sec := range fv.Sections {
+			if sec.End == nil {
+				if av.Status == "complete" {
+					av.Status = "incomplete"
+				}
+				av.Issues = append(av.Issues, fmt.Sprintf("%s#%d: section has no end marker", fv.Kind, sec.Index))
+			} else if !sec.End.Complete {
+				av.Issues = append(av.Issues, fmt.Sprintf("%s#%d: %s", fv.Kind, sec.Index, sec.End.Error))
+			}
+			if sec.HashMatch != nil && !*sec.HashMatch {
+				av.Status = "incomplete"
+				av.Issues = append(av.Issues, fmt.Sprintf("%s#%d: body hash mismatch", fv.Kind, sec.Index))
+			}
+		}
+	}
+	if av.Status == "complete" {
+		if cw := byKind[KindClientResponse]; len(cw.Sections) == 0 || cw.Sections[0].End == nil || !cw.Sections[0].End.Complete {
+			av.Status = "incomplete"
+		}
+	}
+	return av, nil
+}
+
+// postProcessWS 把客户端侧劫持连接的原始字节解析为 WebSocket 消息。
+func (s *Store) postProcessWS(byKind map[string]*FileView) {
+	cr, cw := byKind[KindClientRequest], byKind[KindClientResponse]
+	ext := ""
+	if len(cw.Sections) > 0 {
+		ext = headerValue(cw.Sections[0].Header.Header, "Sec-WebSocket-Extensions")
+	}
+	defl := parseWSExtensions(ext)
+	for _, sec := range cr.Sections {
+		if len(sec.rawConn) > 0 {
+			sec.Messages, sec.MessagesTruncated = parseWSFrames(sec.rawConn, "client→gateway", defl, true, 5000)
+			sec.MessagesTruncated = sec.MessagesTruncated || sec.overflow
+		}
+		sec.rawConn = nil
+	}
+	for _, sec := range cw.Sections {
+		if len(sec.rawConn) > 0 {
+			sec.Messages, sec.MessagesTruncated = parseWSFrames(sec.rawConn, "gateway→client", defl, false, 5000)
+			sec.MessagesTruncated = sec.MessagesTruncated || sec.overflow
+		}
+		sec.rawConn = nil
+	}
+	for _, kind := range []string{KindUpstreamRequest, KindUpstreamResponse} {
+		dir := "gateway→upstream"
+		if kind == KindUpstreamResponse {
+			dir = "upstream→gateway"
+		}
+		for _, sec := range byKind[kind].Sections {
+			for i := range sec.Messages {
+				sec.Messages[i].Dir = dir
+			}
+			sec.rawConn = nil
+		}
+	}
+}
+
+func buildAttempts(req, resp *FileView) []AttemptView {
+	m := map[int]*AttemptView{}
+	get := func(seq int) *AttemptView {
+		if a, ok := m[seq]; ok {
+			return a
+		}
+		a := &AttemptView{Seq: seq, Complete: true, RequestIdx: []int{}, RespIdx: []int{}}
+		m[seq] = a
+		return a
+	}
+	for _, sec := range req.Sections {
+		a := get(sec.Seq)
+		a.RequestIdx = append(a.RequestIdx, sec.Index)
+		if sec.Header.Method != "" && a.Method == "" {
+			a.Method, a.URL = sec.Header.Method, sec.Header.URL
+			a.AccountID = sec.Header.Meta["account_id"]
+			a.SpanID = sec.Header.Meta["span_id"]
+		}
+		if a.Transport == "" {
+			a.Transport = sec.Header.Transport
+		}
+		if v, ok := sec.Header.Meta["ws_reused"].(bool); ok && v {
+			a.WSReused = true
+		}
+		if sec.End == nil || !sec.End.Complete {
+			a.Complete = false
+		}
+	}
+	for _, sec := range resp.Sections {
+		a := get(sec.Seq)
+		a.RespIdx = append(a.RespIdx, sec.Index)
+		if sec.Header.Status != 0 && a.Status == 0 {
+			a.Status = sec.Header.Status
+		}
+		if a.AccountID == nil {
+			a.AccountID = sec.Header.Meta["account_id"]
+		}
+		if sec.End == nil || !sec.End.Complete {
+			a.Complete = false
+			if sec.End != nil && a.Error == "" {
+				a.Error = sec.End.Error
+			}
+		}
+	}
+	out := make([]AttemptView, 0, len(m))
+	for _, a := range m {
+		out = append(out, *a)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Seq < out[j].Seq })
+	return out
+}
+
+// BodyInfo 是下载前预扫描得到的段信息。SHA256 / Bytes 为读取时对原始正文的计算值，
+// Intact 表示与写入时记录的字节数、xxhash64 一致。
+type BodyInfo struct {
+	Header SectionHeader
+	End    *SectionEnd
+	SHA256 string
+	Bytes  int64
+	Intact bool
+}
+
+// StreamBody 把某段正文原样（或按 Content-Encoding 解码后）流式写出，
+// 全程在内存中解压，不落临时文件。返回写出的字节数。
+func (s *Store) StreamBody(w io.Writer, ref, kind string, index int, decode bool, onHeader func(BodyInfo)) (int64, error) {
+	p, err := s.FilePath(ref, kind)
+	if err != nil {
+		return 0, err
+	}
+	// 先扫描一遍取段头/段尾并计算 SHA-256（用于响应头），再流式输出正文。
+	info, err := s.sectionMeta(p, index)
+	if err != nil {
+		return 0, err
+	}
+	hdr := info.Header
+	if onHeader != nil {
+		onHeader(info)
+	}
+	enc := headerValue(hdr.Header, "Content-Encoding")
+	if !decode || enc == "" || enc == "identity" {
+		return s.copySection(w, p, index)
+	}
+	pr, pw := io.Pipe()
+	go func() {
+		_, err := s.copySection(pw, p, index)
+		_ = pw.CloseWithError(err)
+	}()
+	rc, err := DecodeReader(enc, pr)
+	if err != nil {
+		_ = pr.CloseWithError(err)
+		return 0, err
+	}
+	defer func() { _ = rc.Close(); _ = pr.Close() }()
+	return io.Copy(w, rc)
+}
+
+func (s *Store) walkSections(path string, fn func(idx int, f frame) bool) error {
+	f, err := os.Open(path) //nolint:gosec // 已校验
+	if err != nil {
+		return err
+	}
+	defer func() { _ = f.Close() }()
+	dec, err := newDecoder(f)
+	if err != nil {
+		return err
+	}
+	defer dec.Close()
+	fr, err := openFrames(dec)
+	if err != nil {
+		return err
+	}
+	latest := map[uint16]int{}
+	count := 0
+	var buf []byte
+	for {
+		fx, err := fr.next(buf)
+		if errors.Is(err, io.EOF) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		buf = fx.payload[:0]
+		idx := -1
+		if fx.typ == FrameHeader {
+			idx = count
+			latest[fx.seq] = count
+			count++
+		} else if v, ok := latest[fx.seq]; ok {
+			idx = v
+		}
+		if idx >= 0 && !fn(idx, fx) {
+			return nil
+		}
+	}
+}
+
+func (s *Store) sectionMeta(path string, index int) (BodyInfo, error) {
+	var hdr SectionHeader
+	var end *SectionEnd
+	found := false
+	sh, xh := sha256.New(), xxhash.New()
+	var n int64
+	err := s.walkSections(path, func(idx int, f frame) bool {
+		if idx != index {
+			return true
+		}
+		switch f.typ {
+		case FrameHeader:
+			found = true
+			_ = jsonUnmarshal(f.payload, &hdr)
+		case FrameBody:
+			_, _ = sh.Write(f.payload)
+			_, _ = xh.Write(f.payload)
+			n += int64(len(f.payload))
+		case FrameEnd:
+			var e SectionEnd
+			if jsonUnmarshal(f.payload, &e) == nil {
+				end = &e
+			}
+			return false
+		}
+		return true
+	})
+	if err != nil && !found {
+		return BodyInfo{}, err
+	}
+	if !found {
+		return BodyInfo{}, fmt.Errorf("%w: %d", errSectionNotFound, index)
+	}
+	info := BodyInfo{Header: hdr, End: end, SHA256: hex.EncodeToString(sh.Sum(nil)), Bytes: n}
+	info.Intact = end != nil && end.Bytes == n && end.XXH64 == xxh64Hex(xh.Sum64())
+	return info, nil
+}
+
+func (s *Store) copySection(w io.Writer, path string, index int) (int64, error) {
+	var n int64
+	var werr error
+	err := s.walkSections(path, func(idx int, f frame) bool {
+		if idx != index {
+			return true
+		}
+		if f.typ == FrameEnd {
+			return false
+		}
+		if f.typ != FrameBody {
+			return true
+		}
+		m, err := w.Write(f.payload)
+		n += int64(m)
+		if err != nil {
+			werr = err
+			return false
+		}
+		return true
+	})
+	if werr != nil {
+		return n, werr
+	}
+	return n, err
+}
+
+var jsonUnmarshal = json.Unmarshal
diff --git a/backend/internal/audit/config.go b/backend/internal/audit/config.go
new file mode 100644
index 000000000..68207f9ec
--- /dev/null
+++ b/backend/internal/audit/config.go
@@ -0,0 +1,159 @@
+// Package audit 实现网关请求报文的全量归档：每个客户端请求采集
+// 客户端请求、实际上游请求、上游响应、客户端响应四份 Header/Body，
+// 以 zstd 整体压缩写入本地目录，并提供按需流式读取的管理接口。
+//
+// 该包刻意不依赖 service / repository / middleware 等业务包，
+// 业务侧只通过少量钩子（Gin 中间件、RoundTripper、WS Tap、OnUsage）接入，
+// 以保证可作为独立补丁在基线上应用。
+package audit
+
+import (
+	"net/http"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/spf13/viper"
+)
+
+// Config 控制归档行为。所有字段都可由 config.yaml 的 `audit:` 段或
+// AUDIT_* 环境变量（viper AutomaticEnv，`.` 映射为 `_`）配置。
+type Config struct {
+	// Enabled 为 false 时所有钩子直接透传，不产生任何文件。
+	Enabled bool
+	// RootDir 归档根目录，默认 ./data/audit。
+	RootDir string
+	// SessionHeaders 按优先级查找会话 ID 的请求头。
+	SessionHeaders []string
+	// RedactHeaders 落盘前需要脱敏的鉴权类 Header（大小写不敏感）。
+	RedactHeaders []string
+	// RedactQueryParams 落盘前需要脱敏的 URL 查询参数（例如 Gemini 的 ?key=）。
+	RedactQueryParams []string
+	// SessionCacheSize 会话→日期目录缓存的最大条目数（有界 LRU）。
+	SessionCacheSize int
+	// MemoryBufferBytes 单个文件在内存中累积到该大小前不启用流式压缩，
+	// 结束时一次性压缩；超过后切换为后台流式压缩，避免大正文占用内存。
+	MemoryBufferBytes int
+	// EncoderLevel zstd 压缩级别：fastest / default / better / best。
+	EncoderLevel string
+	// DisplayBodyLimit 管理接口单段正文的展示上限（字节），超出部分只能下载；
+	// 仅影响展示，不影响存储。
+	DisplayBodyLimit int
+	// FinalizeTimeout 关闭归档（停机）时等待未完成写入的最长时间。
+	FinalizeTimeout time.Duration
+	// FlushWorkers 后台落盘并发上限（创建文件 + 压缩写入），限制同时打开的文件数。
+	FlushWorkers int
+}
+
+// DefaultSessionHeaders 覆盖常见客户端的会话头：
+// Claude Code（X-Claude-Code-Session-Id）、Codex（session_id / conversation_id）、
+// OpenRouter 及通用客户端（X-Session-Id / Session-Id）、OpenCode、Gemini CLI。
+var DefaultSessionHeaders = []string{
+	"X-Claude-Code-Session-Id",
+	"session_id",
+	"Session-Id",
+	"X-Session-Id",
+	"conversation_id",
+	"X-OpenCode-Session",
+	"X-Gemini-Session-Id",
+	"X-Goog-Session-Id",
+}
+
+// DefaultRedactHeaders 仅包含鉴权类 Header。
+var DefaultRedactHeaders = []string{
+	"Authorization",
+	"Proxy-Authorization",
+	"X-Api-Key",
+	"Api-Key",
+	"X-Goog-Api-Key",
+	"Cookie",
+	"Set-Cookie",
+	"X-Auth-Token",
+}
+
+// DefaultRedactQueryParams 仅包含鉴权类查询参数。
+var DefaultRedactQueryParams = []string{"key", "api_key", "access_token"}
+
+// DefaultConfig 返回默认配置（默认开启，根目录 ./data/audit）。
+func DefaultConfig() Config {
+	return Config{
+		Enabled:           true,
+		RootDir:           "./data/audit",
+		SessionHeaders:    append([]string(nil), DefaultSessionHeaders...),
+		RedactHeaders:     append([]string(nil), DefaultRedactHeaders...),
+		RedactQueryParams: append([]string(nil), DefaultRedactQueryParams...),
+		SessionCacheSize:  10000,
+		MemoryBufferBytes: 512 << 10,
+		EncoderLevel:      "fastest",
+		DisplayBodyLimit:  4 << 20,
+		FinalizeTimeout:   30 * time.Second,
+		FlushWorkers:      max(4, 2*runtime.GOMAXPROCS(0)),
+	}
+}
+
+// ConfigFromViper 从全局 viper 读取 `audit.*`，缺省项回落到 DefaultConfig。
+// 主配置加载（config.Load）已对全局 viper 启用 AutomaticEnv，因此
+// AUDIT_ENABLED / AUDIT_ROOT_DIR 等环境变量同样生效。
+func ConfigFromViper() Config {
+	cfg := DefaultConfig()
+	if viper.IsSet("audit.enabled") {
+		cfg.Enabled = viper.GetBool("audit.enabled")
+	}
+	if v := strings.TrimSpace(viper.GetString("audit.root_dir")); v != "" {
+		cfg.RootDir = v
+	}
+	if v := viper.GetStringSlice("audit.session_headers"); len(v) > 0 {
+		cfg.SessionHeaders = splitList(v)
+	}
+	if v := viper.GetStringSlice("audit.redact_headers"); len(v) > 0 {
+		cfg.RedactHeaders = splitList(v)
+	}
+	if v := viper.GetStringSlice("audit.redact_query_params"); len(v) > 0 {
+		cfg.RedactQueryParams = splitList(v)
+	}
+	if v := viper.GetInt("audit.session_cache_size"); v > 0 {
+		cfg.SessionCacheSize = v
+	}
+	if v := viper.GetInt("audit.memory_buffer_bytes"); v > 0 {
+		cfg.MemoryBufferBytes = v
+	}
+	if v := strings.TrimSpace(viper.GetString("audit.encoder_level")); v != "" {
+		cfg.EncoderLevel = v
+	}
+	if v := viper.GetInt("audit.display_body_limit"); v > 0 {
+		cfg.DisplayBodyLimit = v
+	}
+	if v := viper.GetDuration("audit.finalize_timeout"); v > 0 {
+		cfg.FinalizeTimeout = v
+	}
+	if v := viper.GetInt("audit.flush_workers"); v > 0 {
+		cfg.FlushWorkers = v
+	}
+	return cfg
+}
+
+// splitList 兼容环境变量中逗号分隔的写法。
+func splitList(values []string) []string {
+	out := make([]string, 0, len(values))
+	for _, v := range values {
+		for _, part := range strings.Split(v, ",") {
+			if part = strings.TrimSpace(part); part != "" {
+				out = append(out, part)
+			}
+		}
+	}
+	return out
+}
+
+func canonicalSet(values []string) map[string]struct{} {
+	set := make(map[string]struct{}, len(values))
+	for _, v := range values {
+		v = strings.TrimSpace(v)
+		if v == "" {
+			continue
+		}
+		set[strings.ToLower(v)] = struct{}{}
+		set[strings.ToLower(http.CanonicalHeaderKey(v))] = struct{}{}
+	}
+	return set
+}
diff --git a/backend/internal/audit/file.go b/backend/internal/audit/file.go
new file mode 100644
index 000000000..62a1e2d99
--- /dev/null
+++ b/backend/internal/audit/file.go
@@ -0,0 +1,216 @@
+package audit
+
+import (
+	"bufio"
+	"errors"
+	"os"
+	"sync"
+
+	"github.com/klauspost/compress/zstd"
+)
+
+var errFileClosed = errors.New("audit: archive file closed")
+
+// codec 持有压缩器：一个并发安全的 EncodeAll 编码器（小文件一次性压缩）
+// 和一个流式编码器池（大正文后台流式压缩，复用以控制内存）。
+type codec struct {
+	all     *zstd.Encoder
+	streams sync.Pool
+	opts    []zstd.EOption
+}
+
+func newCodec(level string) (*codec, error) {
+	lvl := zstd.SpeedFastest
+	switch level {
+	case "default":
+		lvl = zstd.SpeedDefault
+	case "better":
+		lvl = zstd.SpeedBetterCompression
+	case "best":
+		lvl = zstd.SpeedBestCompression
+	}
+	opts := []zstd.EOption{
+		zstd.WithEncoderLevel(lvl),
+		zstd.WithEncoderConcurrency(1),
+		zstd.WithLowerEncoderMem(true),
+		zstd.WithWindowSize(1 << 20),
+		zstd.WithEncoderCRC(true),
+		zstd.WithZeroFrames(true),
+	}
+	all, err := zstd.NewWriter(nil, opts...)
+	if err != nil {
+		return nil, err
+	}
+	return &codec{all: all, opts: opts}, nil
+}
+
+func (c *codec) getStream(w *bufio.Writer) (*zstd.Encoder, error) {
+	if enc, ok := c.streams.Get().(*zstd.Encoder); ok {
+		enc.Reset(w)
+		return enc, nil
+	}
+	return zstd.NewWriter(w, c.opts...)
+}
+
+func (c *codec) putStream(enc *zstd.Encoder) {
+	enc.Reset(nil)
+	c.streams.Put(enc)
+}
+
+// archiveFile 是单个 .zst 归档文件的写入端。
+//
+// 写入路径只做内存追加（拷贝），不在业务 goroutine 上压缩，也不做任何文件系统操作：
+//   - 原始内容不超过 threshold 时，关闭阶段一次性 EncodeAll；
+//   - 超过后切换为流式模式，由专属 goroutine 后台压缩落盘，
+//     业务侧仍只是入队，SSE/大正文不受压缩速度影响。
+type archiveFile struct {
+	mu        sync.Mutex
+	codec     *codec
+	open      func() (*os.File, error) // 延迟创建文件（后台 goroutine 中调用）
+	threshold int
+	buf       []byte
+	closed    bool
+	raw       int64
+
+	// 流式模式
+	streaming bool
+	cond      *sync.Cond
+	queue     [][]byte
+	finishing bool
+	done      chan error
+}
+
+func newArchiveFile(open func() (*os.File, error), c *codec, threshold int) *archiveFile {
+	af := &archiveFile{codec: c, open: open, threshold: threshold}
+	af.buf = append(make([]byte, 0, 4096), fileMagic...)
+	af.raw = int64(len(fileMagic))
+	return af
+}
+
+// writeFrame 追加一个帧；payload 超过 maxFramePayload 时自动拆分。
+func (a *archiveFile) writeFrame(typ byte, seq uint16, payload []byte) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed {
+		return errFileClosed
+	}
+	for {
+		n := len(payload)
+		if n > maxFramePayload {
+			n = maxFramePayload
+		}
+		a.appendLocked(typ, seq, payload[:n])
+		payload = payload[n:]
+		if len(payload) == 0 {
+			return nil
+		}
+	}
+}
+
+func (a *archiveFile) appendLocked(typ byte, seq uint16, payload []byte) {
+	a.raw += int64(frameHeaderSize + len(payload))
+	if !a.streaming {
+		a.buf = encodeFrameHeader(a.buf, typ, seq, len(payload))
+		a.buf = append(a.buf, payload...)
+		if len(a.buf) > a.threshold {
+			a.startStreamLocked()
+		}
+		return
+	}
+	chunk := make([]byte, 0, frameHeaderSize+len(payload))
+	chunk = encodeFrameHeader(chunk, typ, seq, len(payload))
+	chunk = append(chunk, payload...)
+	a.queue = append(a.queue, chunk)
+	a.cond.Signal()
+}
+
+func (a *archiveFile) startStreamLocked() {
+	a.streaming = true
+	a.cond = sync.NewCond(&a.mu)
+	a.queue = append(a.queue, a.buf)
+	a.buf = nil
+	a.done = make(chan error, 1)
+	go a.streamLoop()
+}
+
+func (a *archiveFile) streamLoop() {
+	f, err := a.open()
+	var bw *bufio.Writer
+	var enc *zstd.Encoder
+	if err == nil {
+		bw = bufio.NewWriterSize(f, 64<<10)
+		enc, err = a.codec.getStream(bw)
+	}
+	for {
+		a.mu.Lock()
+		for len(a.queue) == 0 && !a.finishing {
+			a.cond.Wait()
+		}
+		batch := a.queue
+		a.queue = nil
+		finishing := a.finishing
+		a.mu.Unlock()
+
+		for _, chunk := range batch {
+			if err == nil {
+				_, err = enc.Write(chunk)
+			}
+		}
+		if finishing && len(batch) == 0 {
+			break
+		}
+	}
+	if enc != nil {
+		if cerr := enc.Close(); err == nil {
+			err = cerr
+		}
+		a.codec.putStream(enc)
+	}
+	if bw != nil {
+		if ferr := bw.Flush(); err == nil {
+			err = ferr
+		}
+	}
+	if f != nil {
+		if cerr := f.Close(); err == nil {
+			err = cerr
+		}
+	}
+	a.done <- err
+}
+
+// close 完成压缩并关闭文件；可重复调用。
+func (a *archiveFile) close() error {
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		return nil
+	}
+	a.closed = true
+	if a.streaming {
+		a.finishing = true
+		a.cond.Signal()
+		a.mu.Unlock()
+		return <-a.done
+	}
+	buf := a.buf
+	a.buf = nil
+	a.mu.Unlock()
+
+	f, err := a.open()
+	if err != nil {
+		return err
+	}
+	out := a.codec.all.EncodeAll(buf, make([]byte, 0, len(buf)/3+64))
+	_, err = f.Write(out)
+	if cerr := f.Close(); err == nil {
+		err = cerr
+	}
+	return err
+}
+
+func (a *archiveFile) rawSize() int64 {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return a.raw
+}
diff --git a/backend/internal/audit/format.go b/backend/internal/audit/format.go
new file mode 100644
index 000000000..0568c9cf6
--- /dev/null
+++ b/backend/internal/audit/format.go
@@ -0,0 +1,90 @@
+package audit
+
+import (
+	"encoding/binary"
+	"time"
+)
+
+// 归档文件 = 一个完整的 zstd 流；解压后的内容为：
+//
+//	Magic(8) | Frame*
+//	Frame = Type(1) | Seq(uint16 BE) | Len(uint32 BE) | Payload(Len)
+//
+// 一个文件内可以有多个 section（以 Seq 区分）：客户端两份文件只有 Seq=0，
+// 上游两份文件中每个调度尝试（attempt）占一个 Seq（从 1 开始）。
+// 正文以原始字节分块写入 FrameBody，不做任何改写或截断；
+// section 以 FrameEnd 结束，缺失 FrameEnd 即视为不完整。
+const (
+	fileMagic = "S2AAUD01"
+
+	FrameHeader byte = 'H' // JSON SectionHeader
+	FrameBody   byte = 'B' // 正文原始字节
+	FrameEnd    byte = 'E' // JSON SectionEnd
+	FrameRaw    byte = 'R' // 协议升级（WebSocket 劫持）后的原始连接字节，展示时再解析帧
+	FrameMsg    byte = 'W' // WebSocket 消息：opcode(1) | unixnano(8) | data
+	FrameNote   byte = 'N' // JSON 附注（连接复用、用量回调等）
+
+	frameHeaderSize = 7
+	maxFramePayload = 1 << 20
+)
+
+// 四份文件的类型。
+const (
+	KindClientRequest    = "client_request"
+	KindUpstreamRequest  = "upstream_request"
+	KindUpstreamResponse = "upstream_response"
+	KindClientResponse   = "client_response"
+)
+
+// Kinds 按展示顺序列出四份文件。
+var Kinds = []string{KindClientRequest, KindUpstreamRequest, KindUpstreamResponse, KindClientResponse}
+
+// SectionHeader 描述一段报文的起始信息（Header 已脱敏）。
+type SectionHeader struct {
+	Kind       string              `json:"kind"`
+	Seq        int                 `json:"seq"`
+	Time       time.Time           `json:"time"`
+	Method     string              `json:"method,omitempty"`
+	URL        string              `json:"url,omitempty"`
+	Proto      string              `json:"proto,omitempty"`
+	Host       string              `json:"host,omitempty"`
+	RemoteAddr string              `json:"remote_addr,omitempty"`
+	Status     int                 `json:"status,omitempty"`
+	Header     map[string][]string `json:"header,omitempty"`
+	// Transport: http / sse / websocket
+	Transport string `json:"transport,omitempty"`
+	// Replay 表示传输层（GetBody）重放了请求体，正文为新一轮发送。
+	Replay bool           `json:"replay,omitempty"`
+	Meta   map[string]any `json:"meta,omitempty"`
+}
+
+// SectionEnd 描述一段报文的结束信息。
+type SectionEnd struct {
+	Time  time.Time `json:"time"`
+	Bytes int64     `json:"bytes"`
+	// XXH64 是写入时对正文计算的 xxhash64（请求路径上的廉价完整性校验）；
+	// 面向使用者的 SHA-256 在读取阶段计算。
+	XXH64    string         `json:"xxh64"`
+	Complete bool           `json:"complete"`
+	Error    string         `json:"error,omitempty"`
+	Meta     map[string]any `json:"meta,omitempty"`
+	RawIn    int64          `json:"raw_in,omitempty"`
+	Messages int64          `json:"messages,omitempty"`
+}
+
+func encodeFrameHeader(dst []byte, typ byte, seq uint16, n int) []byte {
+	var h [frameHeaderSize]byte
+	h[0] = typ
+	binary.BigEndian.PutUint16(h[1:3], seq)
+	binary.BigEndian.PutUint32(h[3:7], uint32(n)) //nolint:gosec // n <= maxFramePayload
+	return append(dst, h[:]...)
+}
+
+// WebSocket 消息 opcode（与 RFC 6455 一致）。
+const (
+	WSOpText   byte = 1
+	WSOpBinary byte = 2
+	WSOpClose  byte = 8
+	WSOpPing   byte = 9
+	WSOpPong   byte = 10
+)
diff --git a/backend/internal/audit/gin.go b/backend/internal/audit/gin.go
new file mode 100644
index 000000000..7ceabc8e1
--- /dev/null
+++ b/backend/internal/audit/gin.go
@@ -0,0 +1,355 @@
+package audit
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/ctxkey"
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+)
+
+var (
+	defaultStore atomic.Pointer[Store]
+	defaultOnce  sync.Once
+)
+
+// Init 按 viper 配置（audit.* / AUDIT_*）初始化进程级归档存储，只执行一次。
+// 由服务启动流程在配置加载后调用；未调用 Init 的进程（测试、工具）不会归档。
+func Init() *Store {
+	defaultOnce.Do(func() {
+		cfg := ConfigFromViper()
+		if !cfg.Enabled {
+			slog.Info("audit_archive_disabled")
+			return
+		}
+		s, err := NewStore(cfg)
+		if err != nil {
+			slog.Error("audit_archive_init_failed", "error", err)
+			return
+		}
+		slog.Info("audit_archive_enabled", "root", s.Root())
+		defaultStore.Store(s)
+	})
+	return defaultStore.Load()
+}
+
+// Default 返回进程级归档存储；未初始化、被禁用或初始化失败时返回 nil，所有钩子随之透传。
+func Default() *Store {
+	return defaultStore.Load()
+}
+
+// SetDefault 替换进程级归档存储（测试与自定义装配使用）。
+func SetDefault(s *Store) {
+	defaultOnce.Do(func() {})
+	defaultStore.Store(s)
+}
+
+// Shutdown 等待进程级归档完成落盘。
+func Shutdown(ctx context.Context) error {
+	return defaultStore.Load().Close(ctx)
+}
+
+// IdentityFunc 在请求结束时从 Gin 上下文提取关联字段（API Key、用户、分组、账户等）。
+// 由装配层提供，以免 audit 包依赖业务包。
+type IdentityFunc func(c *gin.Context) map[string]any
+
+// WrapHandler 把归档采集包裹在 next（通常是 ClientRequestID 中间件）外层：
+// 先预置 client_request_id 与归档器到 context，再执行 next（其内部 c.Next() 会跑完
+// 整条业务链），返回后记录客户端响应并收尾。
+func WrapHandler(next gin.HandlerFunc, ident IdentityFunc) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		s := Default()
+		if s == nil || c.Request == nil {
+			next(c)
+			return
+		}
+		s.serve(c, next, ident)
+	}
+}
+
+func (s *Store) serve(c *gin.Context, next gin.HandlerFunc, ident IdentityFunc) {
+	req := c.Request
+	ctx := req.Context()
+	reqID, _ := ctx.Value(ctxkey.ClientRequestID).(string)
+	reqID = strings.TrimSpace(reqID)
+	if reqID == "" {
+		reqID = uuid.New().String()
+		ctx = context.WithValue(ctx, ctxkey.ClientRequestID, reqID)
+	}
+	session, sessionHeader := SessionFromHeader(req.Header, s.cfg.SessionHeaders)
+	now := s.now()
+	rec, err := s.Begin(reqID, session, sessionHeader, now)
+	if err != nil {
+		s.stats.BeginErrors.Add(1)
+		slog.Warn("audit_archive_begin_failed", "request_id", reqID, "error", err)
+		c.Request = req.WithContext(ctx)
+		next(c)
+		return
+	}
+	ti := traceFromRequest(ctx, req.Header)
+	rec.TraceID, rec.SpanID = ti.TraceID, ti.SpanID
+	ctx = WithRecorder(ctx, rec)
+	c.Request = req.WithContext(ctx)
+
+	transport := "http"
+	if strings.EqualFold(req.Header.Get("Upgrade"), "websocket") {
+		transport = "websocket"
+	}
+	reqSec := rec.startSection(KindClientRequest, SectionHeader{
+		Time:       now,
+		Method:     req.Method,
+		URL:        s.red.URL(req.URL),
+		Proto:      req.Proto,
+		Host:       req.Host,
+		RemoteAddr: req.RemoteAddr,
+		Header:     s.red.Header(req.Header),
+		Transport:  transport,
+		Meta: map[string]any{
+			"request_id":     reqID,
+			"session_id":     session,
+			"session_header": sessionHeader,
+			"trace":          ti,
+		},
+	})
+	var body *teeBody
+	if req.Body != nil && req.Body != http.NoBody {
+		body = &teeBody{ReadCloser: req.Body, sec: reqSec}
+		c.Request.Body = body
+	}
+	w := &respWriter{ResponseWriter: c.Writer, rec: rec, red: s.red, reqSec: reqSec}
+	c.Writer = w
+
+	defer func() {
+		panicked := recover()
+		if c.Writer == w {
+			c.Writer = w.ResponseWriter
+		}
+		s.finishRequest(c, rec, w, body, reqSec, ident, panicked)
+		if panicked != nil {
+			panic(panicked)
+		}
+	}()
+	next(c)
+}
+
+func (s *Store) finishRequest(c *gin.Context, rec *Recorder, w *respWriter, body *teeBody, reqSec *section, ident IdentityFunc, panicked any) {
+	meta := map[string]any{}
+	if ident != nil {
+		func() {
+			defer func() { _ = recover() }()
+			for k, v := range ident(c) {
+				meta[k] = v
+			}
+		}()
+	}
+	if id, _ := c.Request.Context().Value(ctxkey.ClientRequestID).(string); id != "" && id != rec.ID {
+		meta["client_request_id_final"] = id
+	}
+	meta["attempts"] = rec.Attempts()
+	meta["duration_ms"] = time.Since(rec.Started).Milliseconds()
+	if len(c.Errors) > 0 {
+		meta["gin_errors"] = c.Errors.String()
+	}
+	if panicked != nil {
+		meta["panic"] = true
+	}
+
+	// 客户端请求
+	reqComplete, reqErr := true, ""
+	if body != nil {
+		reqComplete, reqErr = body.state()
+	}
+	reqSec.end(reqComplete, reqErr, nil)
+
+	// 客户端响应
+	w.ensureHeader()
+	complete := panicked == nil && c.Request.Context().Err() == nil
+	errText := ""
+	if !complete {
+		if panicked != nil {
+			errText = "handler panic"
+		} else {
+			errText = "client context: " + c.Request.Context().Err().Error()
+		}
+	}
+	if w.hijacked.Load() {
+		meta["hijacked"] = true
+	}
+	meta["status"] = w.Status()
+	meta["response_size"] = w.Size()
+	w.sec().end(complete, errText, meta)
+	rec.Finish()
+}
+
+// teeBody 在业务读取请求体的同时复制到归档；不提前读取，不改变读取行为。
+type teeBody struct {
+	io.ReadCloser
+	sec    *section
+	mu     sync.Mutex
+	eof    bool
+	err    error
+	closed bool
+}
+
+func (t *teeBody) Read(p []byte) (int, error) {
+	n, err := t.ReadCloser.Read(p)
+	if n > 0 {
+		t.sec.body(p[:n])
+	}
+	if err != nil {
+		t.mu.Lock()
+		if errors.Is(err, io.EOF) {
+			t.eof = true
+		} else if t.err == nil {
+			t.err = err
+		}
+		t.mu.Unlock()
+	}
+	return n, err
+}
+
+func (t *teeBody) Close() error {
+	t.mu.Lock()
+	t.closed = true
+	t.mu.Unlock()
+	return t.ReadCloser.Close()
+}
+
+func (t *teeBody) state() (bool, string) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	switch {
+	case t.eof:
+		return true, ""
+	case t.err != nil:
+		return false, "read error: " + t.err.Error()
+	default:
+		return false, "request body not fully consumed by handler"
+	}
+}
+
+// respWriter 复制写给客户端的响应头与正文；WebSocket 劫持后复制原始连接字节。
+type respWriter struct {
+	gin.ResponseWriter
+	rec      *Recorder
+	red      *redactor
+	reqSec   *section
+	once     sync.Once
+	mu       sync.Mutex
+	section  *section
+	hijacked atomic.Bool
+}
+
+func (w *respWriter) sec() *section {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.section
+}
+
+func (w *respWriter) snapshotHeader(status int, extra map[string]any) {
+	w.once.Do(func() {
+		h := w.Header()
+		transport := "http"
+		if strings.HasPrefix(strings.ToLower(h.Get("Content-Type")), "text/event-stream") {
+			transport = "sse"
+		}
+		if status == http.StatusSwitchingProtocols || w.hijacked.Load() {
+			transport = "websocket"
+		}
+		sec := w.rec.startSection(KindClientResponse, SectionHeader{
+			Status:    status,
+			Header:    w.red.Header(h),
+			Transport: transport,
+			Meta:      extra,
+		})
+		w.mu.Lock()
+		w.section = sec
+		w.mu.Unlock()
+	})
+}
+
+func (w *respWriter) ensureHeader() {
+	w.snapshotHeader(w.Status(), map[string]any{"header_snapshot": "at_finish"})
+}
+
+func (w *respWriter) WriteHeaderNow() {
+	w.snapshotHeader(w.Status(), nil)
+	w.ResponseWriter.WriteHeaderNow()
+}
+
+func (w *respWriter) Write(p []byte) (int, error) {
+	w.snapshotHeader(w.Status(), nil)
+	n, err := w.ResponseWriter.Write(p)
+	if n > 0 {
+		w.sec().body(p[:n])
+	}
+	return n, err
+}
+
+func (w *respWriter) WriteString(str string) (int, error) {
+	w.snapshotHeader(w.Status(), nil)
+	n, err := w.ResponseWriter.WriteString(str)
+	if n > 0 {
+		w.sec().body([]byte(str[:n]))
+	}
+	return n, err
+}
+
+// Unwrap 支持 http.ResponseController。
+func (w *respWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+
+// Hijack 劫持后：客户端→服务端的原始字节追加到 client_request，
+// 服务端→客户端的原始字节追加到 client_response（FrameRaw），展示时再解析 WS 帧。
+func (w *respWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	conn, brw, err := w.ResponseWriter.Hijack()
+	if err != nil {
+		return conn, brw, err
+	}
+	w.hijacked.Store(true)
+	w.snapshotHeader(w.Status(), map[string]any{"hijacked": true})
+	tc := &teeConn{Conn: conn, in: w.reqSec, out: w.sec()}
+	if brw == nil {
+		return tc, brw, nil
+	}
+	// 劫持前已被 http.Server 缓冲的客户端字节同样属于入站流。
+	if n := brw.Reader.Buffered(); n > 0 {
+		if b, perr := brw.Peek(n); perr == nil {
+			tc.in.raw(b)
+		}
+	}
+	// 原 Writer 直接写底层连接，替换为写入 teeConn 的新 Writer；先冲刷遗留数据。
+	_ = brw.Flush()
+	return tc, bufio.NewReadWriter(brw.Reader, bufio.NewWriterSize(tc, brw.Writer.Size())), nil
+}
+
+type teeConn struct {
+	net.Conn
+	in  *section
+	out *section
+}
+
+func (t *teeConn) Read(p []byte) (int, error) {
+	n, err := t.Conn.Read(p)
+	if n > 0 {
+		t.in.raw(p[:n])
+	}
+	return n, err
+}
+
+func (t *teeConn) Write(p []byte) (int, error) {
+	n, err := t.Conn.Write(p)
+	if n > 0 {
+		t.out.raw(p[:n])
+	}
+	return n, err
+}
diff --git a/backend/internal/audit/reader.go b/backend/internal/audit/reader.go
new file mode 100644
index 000000000..abda348a7
--- /dev/null
+++ b/backend/internal/audit/reader.go
@@ -0,0 +1,458 @@
+package audit
+
+import (
+	"bufio"
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"io/fs"
+	"os"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/andybalholm/brotli"
+	"github.com/cespare/xxhash/v2"
+	"github.com/klauspost/compress/zstd"
+)
+
+// ErrNotArchive 表示文件不是本归档格式。
+var ErrNotArchive = errors.New("audit: not an archive file")
+
+// newDecoder 在内存中流式解压，不产生临时文件。
+func newDecoder(r io.Reader) (*zstd.Decoder, error) {
+	return zstd.NewReader(r,
+		zstd.WithDecoderConcurrency(1),
+		zstd.WithDecoderLowmem(true),
+		zstd.WithDecoderMaxWindow(64<<20),
+	)
+}
+
+// frameReader 顺序读取解压后的帧。
+type frameReader struct {
+	r   *bufio.Reader
+	hdr [frameHeaderSize]byte
+}
+
+type frame struct {
+	typ     byte
+	seq     uint16
+	payload []byte
+}
+
+func openFrames(r io.Reader) (*frameReader, error) {
+	br := bufio.NewReaderSize(r, 64<<10)
+	magic := make([]byte, len(fileMagic))
+	if _, err := io.ReadFull(br, magic); err != nil {
+		if errors.Is(err, io.EOF) {
+			return nil, io.EOF
+		}
+		return nil, err
+	}
+	if string(magic) != fileMagic {
+		return nil, ErrNotArchive
+	}
+	return &frameReader{r: br}, nil
+}
+
+// next 读取一帧；payload 复用 buf。返回 io.EOF 表示正常结束，io.ErrUnexpectedEOF 表示截断。
+func (fr *frameReader) next(buf []byte) (frame, error) {
+	if _, err := io.ReadFull(fr.r, fr.hdr[:]); err != nil {
+		if errors.Is(err, io.EOF) {
+			return frame{}, io.EOF
+		}
+		return frame{}, io.ErrUnexpectedEOF
+	}
+	n := int(binary.BigEndian.Uint32(fr.hdr[3:7]))
+	if n > maxFramePayload+16 {
+		return frame{}, fmt.Errorf("audit: frame too large (%d)", n)
+	}
+	if cap(buf) < n {
+		buf = make([]byte, n)
+	}
+	buf = buf[:n]
+	if _, err := io.ReadFull(fr.r, buf); err != nil {
+		return frame{}, io.ErrUnexpectedEOF
+	}
+	return frame{typ: fr.hdr[0], seq: binary.BigEndian.Uint16(fr.hdr[1:3]), payload: buf}, nil
+}
+
+// FileView 是单个归档文件的展示视图。
+type FileView struct {
+	Kind           string           `json:"kind"`
+	Exists         bool             `json:"exists"`
+	CompressedSize int64            `json:"compressed_size"`
+	RawSize        int64            `json:"raw_size"`
+	Status         string           `json:"status"` // ok / missing / empty / truncated / corrupt
+	Error          string           `json:"error,omitempty"`
+	Sections       []*SectionView   `json:"sections"`
+	Notes          []map[string]any `json:"notes,omitempty"`
+}
+
+// SectionView 是一段报文的展示视图。
+type SectionView struct {
+	Index    int           `json:"index"`
+	Seq      int           `json:"seq"`
+	Header   SectionHeader `json:"header"`
+	End      *SectionEnd   `json:"end,omitempty"`
+	Complete bool          `json:"complete"`
+	// BodyBytes / BodySHA256 为读取时计算的值；HashMatch 以写入时记录的字节数与 xxhash64 比对。
+	BodyBytes         int64       `json:"body_bytes"`
+	BodySHA256        string      `json:"body_sha256"`
+	HashMatch         *bool       `json:"hash_match,omitempty"`
+	Body              *BodyView   `json:"body,omitempty"`
+	Messages          []WSMessage `json:"messages,omitempty"`
+	MessagesTruncated bool        `json:"messages_truncated,omitempty"`
+	RawBytes          int64       `json:"raw_bytes,omitempty"`
+
+	hash     hash.Hash
+	xxh      *xxhash.Digest
+	rawBody  []byte
+	rawConn  []byte
+	limit    int
+	overflow bool
+}
+
+// BodyView 是正文的展示形态（仅在展示阶段解析）。
+type BodyView struct {
+	ContentEncoding string     `json:"content_encoding,omitempty"`
+	Decoded         bool       `json:"decoded"`
+	DecodeError     string     `json:"decode_error,omitempty"`
+	IsText          bool       `json:"is_text"`
+	Text            string     `json:"text,omitempty"`
+	Base64          []byte     `json:"base64,omitempty"`
+	TruncatedForUI  bool       `json:"truncated_for_display"`
+	SSE             []SSEEvent `json:"sse,omitempty"`
+	SSEDone         *bool      `json:"sse_terminated,omitempty"`
+}
+
+// SSEEvent 是解析后的一个 SSE 事件。
+type SSEEvent struct {
+	Event string `json:"event,omitempty"`
+	ID    string `json:"id,omitempty"`
+	Data  string `json:"data"`
+}
+
+// WSMessage 是一条 WebSocket 消息。
+type WSMessage struct {
+	Dir        string    `json:"dir"` // in / out（相对写入方）
+	Op         string    `json:"op"`
+	Time       time.Time `json:"time,omitempty"`
+	Size       int       `json:"size"`
+	Compressed bool      `json:"compressed,omitempty"`
+	Text       string    `json:"text,omitempty"`
+	Base64     []byte    `json:"base64,omitempty"`
+	Error      string    `json:"error,omitempty"`
+}
+
+// ReadFile 解析一个归档文件。displayLimit 限制每段保留用于展示的正文字节，
+// 超出部分仍参与计数与哈希校验，可通过下载接口完整获取。
+func ReadFile(path, kind string, displayLimit int) *FileView {
+	fv := &FileView{Kind: kind, Sections: []*SectionView{}}
+	st, err := os.Stat(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		fv.Status = "missing"
+		return fv
+	}
+	if err != nil {
+		fv.Status, fv.Error = "error", err.Error()
+		return fv
+	}
+	fv.Exists = true
+	fv.CompressedSize = st.Size()
+	if st.Size() == 0 {
+		// 文件已创建但尚未落盘：请求仍在进行，或进程在落盘前退出。
+		fv.Status = "empty"
+		return fv
+	}
+	f, err := os.Open(path) //nolint:gosec // 路径已由 FilePath 校验
+	if err != nil {
+		fv.Status, fv.Error = "error", err.Error()
+		return fv
+	}
+	defer func() { _ = f.Close() }()
+	dec, err := newDecoder(f)
+	if err != nil {
+		fv.Status, fv.Error = "corrupt", err.Error()
+		return fv
+	}
+	defer dec.Close()
+	counter := &countingReader{r: dec}
+	fr, err := openFrames(counter)
+	if err != nil {
+		fv.Status, fv.Error = "corrupt", err.Error()
+		return fv
+	}
+	latest := map[uint16]*SectionView{}
+	var buf []byte
+	fv.Status = "ok"
+	for {
+		fr2, err := fr.next(buf)
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			fv.Status, fv.Error = "truncated", err.Error()
+			break
+		}
+		buf = fr2.payload[:0]
+		switch fr2.typ {
+		case FrameHeader:
+			sv := &SectionView{Index: len(fv.Sections), Seq: int(fr2.seq), hash: sha256.New(), xxh: xxhash.New(), limit: displayLimit}
+			if err := json.Unmarshal(fr2.payload, &sv.Header); err != nil {
+				sv.Header.Kind = kind
+			}
+			fv.Sections = append(fv.Sections, sv)
+			latest[fr2.seq] = sv
+		case FrameNote:
+			var note map[string]any
+			if json.Unmarshal(fr2.payload, &note) == nil {
+				fv.Notes = append(fv.Notes, note)
+			}
+		default:
+			sv := latest[fr2.seq]
+			if sv == nil {
+				continue
+			}
+			sv.consume(fr2)
+		}
+	}
+	fv.RawSize = counter.n
+	if fv.Status == "ok" && counter.err != nil && !errors.Is(counter.err, io.EOF) {
+		fv.Status, fv.Error = "truncated", counter.err.Error()
+	}
+	for _, sv := range fv.Sections {
+		sv.finalize()
+	}
+	return fv
+}
+
+type countingReader struct {
+	r   io.Reader
+	n   int64
+	err error
+}
+
+func (c *countingReader) Read(p []byte) (int, error) {
+	n, err := c.r.Read(p)
+	c.n += int64(n)
+	if err != nil {
+		c.err = err
+	}
+	return n, err
+}
+
+func (sv *SectionView) consume(f frame) {
+	switch f.typ {
+	case FrameBody:
+		_, _ = sv.hash.Write(f.payload)
+		_, _ = sv.xxh.Write(f.payload)
+		sv.BodyBytes += int64(len(f.payload))
+		if room := sv.limit - len(sv.rawBody); room > 0 {
+			n := len(f.payload)
+			if n > room {
+				n = room
+				sv.overflow = true
+			}
+			sv.rawBody = append(sv.rawBody, f.payload[:n]...)
+		} else {
+			sv.overflow = true
+		}
+	case FrameRaw:
+		sv.RawBytes += int64(len(f.payload))
+		if room := sv.limit - len(sv.rawConn); room > 0 {
+			n := min(len(f.payload), room)
+			sv.rawConn = append(sv.rawConn, f.payload[:n]...)
+			if n < len(f.payload) {
+				sv.overflow = true
+			}
+		} else {
+			sv.overflow = true
+		}
+	case FrameMsg:
+		if len(f.payload) < 9 {
+			return
+		}
+		if len(sv.Messages) >= 5000 {
+			sv.MessagesTruncated = true
+			return
+		}
+		data := f.payload[9:]
+		m := WSMessage{
+			Op:   opName(f.payload[0]),
+			Time: time.Unix(0, int64(binary.BigEndian.Uint64(f.payload[1:9]))), //nolint:gosec // 写入时为正数
+			Size: len(data),
+		}
+		setPayload(&m.Text, &m.Base64, data, 256<<10)
+		sv.Messages = append(sv.Messages, m)
+	case FrameEnd:
+		var e SectionEnd
+		if json.Unmarshal(f.payload, &e) == nil {
+			sv.End = &e
+		}
+	}
+}
+
+func (sv *SectionView) finalize() {
+	sv.BodySHA256 = hex.EncodeToString(sv.hash.Sum(nil))
+	if sv.End != nil {
+		sv.Complete = sv.End.Complete
+		match := sv.End.Bytes == sv.BodyBytes && sv.End.XXH64 == xxh64Hex(sv.xxh.Sum64())
+		sv.HashMatch = &match
+	}
+	if sv.BodyBytes > 0 {
+		sv.Body = buildBodyView(sv.Header, sv.rawBody, sv.overflow)
+	}
+	sv.rawBody = nil
+}
+
+func setPayload(text *string, b64 *[]byte, data []byte, limit int) {
+	if len(data) > limit {
+		data = data[:limit]
+	}
+	if utf8.Valid(data) {
+		*text = string(data)
+	} else {
+		*b64 = append([]byte(nil), data...)
+	}
+}
+
+func opName(op byte) string {
+	switch op {
+	case WSOpText:
+		return "text"
+	case WSOpBinary:
+		return "binary"
+	case WSOpClose:
+		return "close"
+	case WSOpPing:
+		return "ping"
+	case WSOpPong:
+		return "pong"
+	case 0:
+		return "continuation"
+	default:
+		return fmt.Sprintf("op_%d", op)
+	}
+}
+
+func headerValue(h map[string][]string, key string) string {
+	for k, vs := range h {
+		if strings.EqualFold(k, key) && len(vs) > 0 {
+			return vs[0]
+		}
+	}
+	return ""
+}
+
+// buildBodyView 解码 Content-Encoding（仅展示用途），并解析 SSE。
+func buildBodyView(h SectionHeader, raw []byte, overflow bool) *BodyView {
+	bv := &BodyView{TruncatedForUI: overflow}
+	enc := strings.ToLower(strings.TrimSpace(headerValue(h.Header, "Content-Encoding")))
+	data := raw
+	if enc != "" && enc != "identity" {
+		bv.ContentEncoding = enc
+		decoded, err := decodeContent(enc, raw, 4*len(raw)+(1<<20))
+		if err != nil && len(decoded) == 0 {
+			bv.DecodeError = err.Error()
+		} else {
+			bv.Decoded = true
+			if err != nil {
+				bv.DecodeError = "partial: " + err.Error()
+			}
+			data = decoded
+		}
+	}
+	if utf8.Valid(data) || (overflow && utf8.Valid(trimIncompleteRune(data))) {
+		bv.IsText = true
+		bv.Text = string(data)
+	} else {
+		bv.Base64 = data
+	}
+	ct := strings.ToLower(headerValue(h.Header, "Content-Type"))
+	if bv.IsText && (strings.HasPrefix(ct, "text/event-stream") || h.Transport == "sse") {
+		bv.SSE, bv.SSEDone = parseSSE(bv.Text)
+	}
+	return bv
+}
+
+func trimIncompleteRune(b []byte) []byte {
+	for i := 0; i < 4 && len(b) > 0; i++ {
+		if utf8.Valid(b) {
+			return b
+		}
+		b = b[:len(b)-1]
+	}
+	return b
+}
+
+// DecodeReader 返回 Content-Encoding 解码读取器（内存流式）。
+func DecodeReader(enc string, r io.Reader) (io.ReadCloser, error) {
+	switch strings.ToLower(strings.TrimSpace(enc)) {
+	case "gzip", "x-gzip":
+		return gzip.NewReader(r)
+	case "deflate":
+		return flate.NewReader(r), nil
+	case "br":
+		return io.NopCloser(brotli.NewReader(r)), nil
+	case "zstd":
+		d, err := newDecoder(r)
+		if err != nil {
+			return nil, err
+		}
+		return d.IOReadCloser(), nil
+	default:
+		return nil, fmt.Errorf("unsupported content-encoding %q", enc)
+	}
+}
+
+func decodeContent(enc string, raw []byte, limit int) ([]byte, error) {
+	rc, err := DecodeReader(enc, bytes.NewReader(raw))
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = rc.Close() }()
+	out, err := io.ReadAll(io.LimitReader(rc, int64(limit)))
+	return out, err
+}
+
+func parseSSE(text string) ([]SSEEvent, *bool) {
+	var events []SSEEvent
+	done := false
+	text = strings.ReplaceAll(text, "\r\n", "\n")
+	for _, block := range strings.Split(text, "\n\n") {
+		if strings.TrimSpace(block) == "" {
+			continue
+		}
+		var ev SSEEvent
+		var data []string
+		for _, line := range strings.Split(block, "\n") {
+			switch {
+			case strings.HasPrefix(line, "event:"):
+				ev.Event = strings.TrimSpace(strings.TrimPrefix(line, "event:"))
+			case strings.HasPrefix(line, "id:"):
+				ev.ID = strings.TrimSpace(strings.TrimPrefix(line, "id:"))
+			case strings.HasPrefix(line, "data:"):
+				data = append(data, strings.TrimPrefix(strings.TrimPrefix(line, "data:"), " "))
+			}
+		}
+		ev.Data = strings.Join(data, "\n")
+		if ev.Data == "[DONE]" || ev.Event == "message_stop" || ev.Event == "response.completed" || ev.Event == "response.done" ||
+			strings.Contains(ev.Data, `"finishReason"`) {
+			done = true
+		}
+		events = append(events, ev)
+		if len(events) >= 20000 {
+			break
+		}
+	}
+	return events, &done
+}
diff --git a/backend/internal/audit/recorder.go b/backend/internal/audit/recorder.go
new file mode 100644
index 000000000..e20dd3a5b
--- /dev/null
+++ b/backend/internal/audit/recorder.go
@@ -0,0 +1,291 @@
+package audit
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"log/slog"
+	"maps"
+	"os"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cespare/xxhash/v2"
+)
+
+func xxh64Hex(v uint64) string {
+	s := strconv.FormatUint(v, 16)
+	for len(s) < 16 {
+		s = "0" + s
+	}
+	return s
+}
+
+type ctxKey struct{}
+
+// WithRecorder 把请求归档器放入 context，供 RoundTripper / WS Tap / OnUsage 查找。
+func WithRecorder(ctx context.Context, r *Recorder) context.Context {
+	return context.WithValue(ctx, ctxKey{}, r)
+}
+
+// FromContext 取出请求归档器；未启用归档时返回 nil。
+func FromContext(ctx context.Context) *Recorder {
+	if ctx == nil {
+		return nil
+	}
+	r, _ := ctx.Value(ctxKey{}).(*Recorder)
+	return r
+}
+
+// Recorder 是单个客户端请求的归档器（四个文件）。
+type Recorder struct {
+	store         *Store
+	ID            string
+	Session       string
+	SessionHeader string
+	TraceID       string
+	sessDir       string
+	SpanID        string
+	Started       time.Time
+
+	files    [4]*archiveFile
+	attempts atomic.Int32
+	finished atomic.Bool
+
+	mu     sync.Mutex
+	open   map[*section]struct{}
+	lastWS int32
+	ref    string
+	usage  []IndexEntry // 结束前收到的用量回调，落盘时写入索引
+
+	filesOnce sync.Once
+	filesRes  [4]*os.File
+	filesErr  error
+}
+
+// ArchiveRef 返回归档位置（相对根目录）；文件尚未创建时为空。
+func (r *Recorder) ArchiveRef() string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.ref
+}
+
+func (r *Recorder) file(kind string) *archiveFile {
+	for i, k := range Kinds {
+		if k == kind {
+			return r.files[i]
+		}
+	}
+	return nil
+}
+
+// NextAttempt 分配一个上游调度尝试序号（从 1 开始）。
+func (r *Recorder) NextAttempt() int {
+	return int(r.attempts.Add(1))
+}
+
+// Attempts 返回已分配的尝试数。
+func (r *Recorder) Attempts() int { return int(r.attempts.Load()) }
+
+// section 是文件内一段报文的写入句柄，负责字节计数与 xxhash64。
+type section struct {
+	rec      *Recorder
+	file     *archiveFile
+	seq      uint16
+	mu       sync.Mutex
+	h        *xxhash.Digest
+	n        int64
+	rawIn    int64
+	messages int64
+	ended    bool
+}
+
+func (r *Recorder) startSection(kind string, hdr SectionHeader) *section {
+	if r == nil || r.finished.Load() {
+		return nil
+	}
+	f := r.file(kind)
+	if f == nil {
+		return nil
+	}
+	hdr.Kind = kind
+	if hdr.Time.IsZero() {
+		hdr.Time = time.Now()
+	}
+	payload, err := json.Marshal(hdr)
+	if err != nil {
+		return nil
+	}
+	seq := uint16(hdr.Seq) //nolint:gosec // attempts are bounded far below 65535
+	if err := f.writeFrame(FrameHeader, seq, payload); err != nil {
+		r.store.stats.DroppedWrites.Add(1)
+		return nil
+	}
+	s := &section{rec: r, file: f, seq: seq, h: xxhash.New()}
+	r.mu.Lock()
+	r.open[s] = struct{}{}
+	r.mu.Unlock()
+	return s
+}
+
+func (s *section) body(p []byte) {
+	if s == nil || len(p) == 0 {
+		return
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.ended {
+		return
+	}
+	if err := s.file.writeFrame(FrameBody, s.seq, p); err != nil {
+		s.rec.store.stats.DroppedWrites.Add(1)
+		return
+	}
+	_, _ = s.h.Write(p)
+	s.n += int64(len(p))
+}
+
+// raw 记录协议升级后的原始连接字节（不计入正文哈希）。
+func (s *section) raw(p []byte) {
+	if s == nil || len(p) == 0 {
+		return
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.ended {
+		return
+	}
+	if err := s.file.writeFrame(FrameRaw, s.seq, p); err != nil {
+		s.rec.store.stats.DroppedWrites.Add(1)
+		return
+	}
+	s.rawIn += int64(len(p))
+}
+
+// message 记录一条 WebSocket 消息。
+func (s *section) message(op byte, data []byte) {
+	if s == nil {
+		return
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.ended {
+		return
+	}
+	buf := make([]byte, 9+len(data))
+	buf[0] = op
+	binary.BigEndian.PutUint64(buf[1:9], uint64(time.Now().UnixNano())) //nolint:gosec // 时间戳为正
+	copy(buf[9:], data)
+	if err := s.file.writeFrame(FrameMsg, s.seq, buf); err != nil {
+		s.rec.store.stats.DroppedWrites.Add(1)
+		return
+	}
+	s.messages++
+}
+
+func (s *section) end(complete bool, errText string, meta map[string]any) {
+	if s == nil {
+		return
+	}
+	s.mu.Lock()
+	if s.ended {
+		s.mu.Unlock()
+		return
+	}
+	s.ended = true
+	e := SectionEnd{
+		Time:     time.Now(),
+		Bytes:    s.n,
+		XXH64:    xxh64Hex(s.h.Sum64()),
+		Complete: complete,
+		Error:    errText,
+		Meta:     meta,
+		RawIn:    s.rawIn,
+		Messages: s.messages,
+	}
+	payload, _ := json.Marshal(e)
+	if err := s.file.writeFrame(FrameEnd, s.seq, payload); err != nil {
+		s.rec.store.stats.DroppedWrites.Add(1)
+	}
+	s.mu.Unlock()
+
+	s.rec.mu.Lock()
+	delete(s.rec.open, s)
+	s.rec.mu.Unlock()
+}
+
+// Note 追加一条附注到客户端响应文件（例如 WS 连接复用、用量回调）。
+func (r *Recorder) Note(kind string, seq int, note map[string]any) {
+	if r == nil || r.finished.Load() {
+		return
+	}
+	f := r.file(kind)
+	if f == nil {
+		return
+	}
+	note = maps.Clone(note)
+	if note == nil {
+		note = map[string]any{}
+	}
+	note["time"] = time.Now()
+	payload, err := json.Marshal(note)
+	if err != nil {
+		return
+	}
+	if f.writeFrame(FrameNote, uint16(seq), payload) != nil { //nolint:gosec // bounded
+		r.store.stats.DroppedWrites.Add(1)
+	}
+}
+
+// Finish 结束归档：未结束的 section 标记为不完整，随后在后台创建文件、
+// 完成压缩落盘并写索引，不阻塞客户端响应的收尾。
+func (r *Recorder) Finish() {
+	if r == nil {
+		return
+	}
+	r.mu.Lock()
+	if r.finished.Load() {
+		r.mu.Unlock()
+		return
+	}
+	r.finished.Store(true)
+	open := make([]*section, 0, len(r.open))
+	for s := range r.open {
+		open = append(open, s)
+	}
+	usage := r.usage
+	r.usage = nil
+	r.mu.Unlock()
+	for _, s := range open {
+		s.end(false, "archive finalized before stream closed", nil)
+	}
+	r.store.stats.FlushBacklog.Add(1)
+	go func() {
+		defer r.store.pending.Done()
+		// 有界并发：限制同时创建/写入的文件数，突发流量下排队而不是耗尽文件句柄。
+		r.store.flushSem <- struct{}{}
+		r.store.stats.FlushBacklog.Add(-1)
+		defer func() { <-r.store.flushSem }()
+		if _, err := r.ensureFiles(); err == nil {
+			ref := r.ArchiveRef()
+			for _, e := range usage {
+				e.Ref = ref
+				r.store.writeUsageIndex(e)
+			}
+		}
+		var raw int64
+		for _, f := range r.files {
+			raw += f.rawSize()
+			if err := f.close(); err != nil {
+				r.store.stats.CloseErrors.Add(1)
+				slog.Warn("audit_archive_close_failed", "request_id", r.ID, "error", err)
+			}
+		}
+		r.store.stats.RawBytes.Add(raw)
+	}()
+}
+
+// Finished 表示归档已结束（之后的写入将被丢弃并计数）。
+func (r *Recorder) Finished() bool { return r == nil || r.finished.Load() }
