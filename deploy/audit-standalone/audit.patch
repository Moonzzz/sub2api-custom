+<template>
+  <div class="ab" data-testid="audit-body">
+    <div class="ab-bar">
+      <span v-if="loading" class="ab-muted">{{ text.loading }}</span>
+      <span v-else-if="loadError" class="ab-note--bad">{{ loadError }}</span>
+      <span class="ab-spacer"></span>
