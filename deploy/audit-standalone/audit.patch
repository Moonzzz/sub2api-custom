new file mode 100644
index 000000000..d19410882
--- /dev/null
+++ b/backend/internal/audit/redact.go
@@ -0,0 +1,128 @@
+package audit
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+// redactor 只处理鉴权类 Header / 查询参数，且只作用于归档副本，绝不修改真实请求。
+type redactor struct {
+	headers map[string]struct{}
+	query   map[string]struct{}
+}
+
+func newRedactor(cfg Config) *redactor {
+	q := make(map[string]struct{}, len(cfg.RedactQueryParams))
+	for _, p := range cfg.RedactQueryParams {
+		if p = strings.ToLower(strings.TrimSpace(p)); p != "" {
+			q[p] = struct{}{}
+		}
+	}
+	return &redactor{headers: canonicalSet(cfg.RedactHeaders), query: q}
+}
+
+// MaskSecret 保留前后各 4 位，中间以 * 替换；长度不足 9 时全部遮蔽，
+// 以保证原值不会通过前后缀拼回。对 "Bearer xxx" 这类带方案前缀的值只遮蔽凭据部分。
+func MaskSecret(value string) string {
+	if value == "" {
+		return ""
+	}
+	scheme := ""
+	cred := value
+	if i := strings.IndexByte(value, ' '); i > 0 && i < 16 && !strings.ContainsAny(value[:i], "=;,") {
+		scheme, cred = value[:i+1], value[i+1:]
+	}
+	return scheme + maskToken(cred)
+}
+
+func maskToken(v string) string {
+	r := []rune(v)
+	if len(r) <= 8 {
+		return strings.Repeat("*", len(r))
+	}
+	return string(r[:4]) + strings.Repeat("*", len(r)-8) + string(r[len(r)-4:])
+}
+
+// Header 返回脱敏后的 Header 副本（多值保持顺序）。
+func (r *redactor) Header(h http.Header) map[string][]string {
+	out := make(map[string][]string, len(h))
+	for k, vs := range h {
+		cp := make([]string, len(vs))
+		_, sensitive := r.headers[strings.ToLower(k)]
+		for i, v := range vs {
+			if sensitive {
+				cp[i] = r.maskHeaderValue(k, v)
+			} else {
+				cp[i] = v
+			}
+		}
+		out[k] = cp
+	}
+	return out
+}
+
+func (r *redactor) maskHeaderValue(key, v string) string {
+	switch strings.ToLower(key) {
+	case "cookie":
+		return maskPairs(v, ";", "=")
+	case "set-cookie":
+		// 仅遮蔽 name=value 的 value，保留属性（Path/Expires 等）。
+		parts := strings.SplitN(v, ";", 2)
+		masked := maskPairs(parts[0], ";", "=")
+		if len(parts) == 2 {
+			return masked + ";" + parts[1]
+		}
+		return masked
+	default:
+		return MaskSecret(v)
+	}
+}
+
+func maskPairs(v, sep, kv string) string {
+	items := strings.Split(v, sep)
+	for i, item := range items {
+		if j := strings.Index(item, kv); j >= 0 {
+			items[i] = item[:j+1] + maskToken(item[j+1:])
+		} else {
+			items[i] = maskToken(item)
+		}
+	}
+	return strings.Join(items, sep)
+}
+
+// URL 返回脱敏后的 URL 字符串；仅替换鉴权类查询参数，其余原样保留（含编码与顺序）。
+func (r *redactor) URL(u *url.URL) string {
+	if u == nil {
+		return ""
+	}
+	if u.RawQuery == "" || len(r.query) == 0 {
+		return u.String()
+	}
+	parts := strings.Split(u.RawQuery, "&")
+	changed := false
+	for i, p := range parts {
+		name, val, ok := strings.Cut(p, "=")
+		if !ok {
+			continue
+		}
+		decoded, err := url.QueryUnescape(name)
+		if err != nil {
+			decoded = name
+		}
+		if _, hit := r.query[strings.ToLower(decoded)]; hit {
+			raw, err := url.QueryUnescape(val)
+			if err != nil {
+				raw = val
+			}
+			parts[i] = name + "=" + url.QueryEscape(maskToken(raw))
+			changed = true
+		}
+	}
+	if !changed {
+		return u.String()
+	}
+	cp := *u
+	cp.RawQuery = strings.Join(parts, "&")
+	return cp.String()
+}
diff --git a/backend/internal/audit/session.go b/backend/internal/audit/session.go
new file mode 100644
index 000000000..c737b5f60
--- /dev/null
+++ b/backend/internal/audit/session.go
@@ -0,0 +1,179 @@
+package audit
+
+import (
+	"container/list"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+)
+
+// NoSessionDir 是无会话请求共用的目录名（位于当天日期目录下）。
+const NoSessionDir = "nosession"
+
+var safeNameRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$`)
+
+// safeName 把任意外部 ID 映射为安全的单级文件名：
+// 合法字符的原样保留，否则（或与保留名冲突时）使用 "h-" + sha256 前缀。
+func safeName(id string) string {
+	id = strings.TrimSpace(id)
+	if safeNameRE.MatchString(id) && id != NoSessionDir && !strings.Contains(id, "..") {
+		return id
+	}
+	sum := sha256.Sum256([]byte(id))
+	return "h-" + hex.EncodeToString(sum[:16])
+}
+
+func hashKey(id string) string {
+	sum := sha256.Sum256([]byte(id))
+	return hex.EncodeToString(sum[:])
+}
+
+// SessionFromHeader 按配置的优先级读取会话 ID。
+func SessionFromHeader(h http.Header, names []string) (string, string) {
+	for _, name := range names {
+		if v := strings.TrimSpace(h.Get(name)); v != "" {
+			return v, name
+		}
+		// Go 会把 session_id 规范化为 Session_id，部分代理会保留原始大小写：兜底精确匹配。
+		if vs, ok := h[name]; ok && len(vs) > 0 && strings.TrimSpace(vs[0]) != "" {
+			return strings.TrimSpace(vs[0]), name
+		}
+	}
+	return "", ""
+}
+
+func dateDir(t time.Time) string {
+	return t.Format("2006-01") + "/" + t.Format("02")
+}
+
+// sessionDirs 把会话固定到首次出现的日期目录。
+//
+// 持久化：.sessions/<sha256[:2]>/<sha256> 标记文件记录首个日期目录，
+// 以 link(2) 原子创建，重启后 O(1) 读取，不扫描任何历史目录；
+// 内存中只保留有界 LRU 缓存。
+type sessionDirs struct {
+	root  string
+	cap   int
+	mu    sync.Mutex
+	ll    *list.List
+	items map[string]*list.Element
+}
+
+type sessionEntry struct {
+	key string
+	dir string
+}
+
+func newSessionDirs(root string, capacity int) *sessionDirs {
+	if capacity <= 0 {
+		capacity = 10000
+	}
+	return &sessionDirs{root: root, cap: capacity, ll: list.New(), items: make(map[string]*list.Element)}
+}
+
+func (d *sessionDirs) cached(key string) (string, bool) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if el, ok := d.items[key]; ok {
+		if e, ok := el.Value.(*sessionEntry); ok {
+			d.ll.MoveToFront(el)
+			return e.dir, true
+		}
+	}
+	return "", false
+}
+
+func (d *sessionDirs) remember(key, dir string) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if el, ok := d.items[key]; ok {
+		if e, ok := el.Value.(*sessionEntry); ok {
+			e.dir = dir
+		}
+		d.ll.MoveToFront(el)
+		return
+	}
+	d.items[key] = d.ll.PushFront(&sessionEntry{key: key, dir: dir})
+	for d.ll.Len() > d.cap {
+		last := d.ll.Back()
+		d.ll.Remove(last)
+		if e, ok := last.Value.(*sessionEntry); ok {
+			delete(d.items, e.key)
+		}
+	}
+}
+
+func (d *sessionDirs) len() int {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.ll.Len()
+}
+
+// Resolve 返回会话的相对目录（yyyy-MM/dd/<session>）。
+func (d *sessionDirs) Resolve(session string, now time.Time) (string, error) {
+	if session == "" {
+		return dateDir(now) + "/" + NoSessionDir, nil
+	}
+	key := hashKey(session)
+	if dir, ok := d.cached(key); ok {
+		return dir, nil
+	}
+	marker := filepath.Join(d.root, ".sessions", key[:2], key)
+	if dir, err := readSessionMarker(marker); err == nil {
+		d.remember(key, dir)
+		return dir, nil
+	} else if !errors.Is(err, fs.ErrNotExist) {
+		return "", err
+	}
+
+	dir := dateDir(now) + "/" + safeName(session)
+	if err := os.MkdirAll(filepath.Dir(marker), 0o750); err != nil {
+		return "", err
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(marker), ".tmp-*")
+	if err != nil {
+		return "", err
+	}
+	_, werr := fmt.Fprintf(tmp, "%s\n", dir)
+	cerr := tmp.Close()
+	if werr != nil || cerr != nil {
+		_ = os.Remove(tmp.Name())
+		return "", errors.Join(werr, cerr)
+	}
+	linkErr := os.Link(tmp.Name(), marker)
+	_ = os.Remove(tmp.Name())
+	if linkErr != nil {
+		if !errors.Is(linkErr, fs.ErrExist) {
+			return "", linkErr
+		}
+		// 并发竞争：另一请求已写入，以其为准。
+		existing, err := readSessionMarker(marker)
+		if err != nil {
+			return "", err
+		}
+		dir = existing
+	}
+	d.remember(key, dir)
+	return dir, nil
+}
+
+func readSessionMarker(path string) (string, error) {
+	b, err := os.ReadFile(path) //nolint:gosec // path 由 sha256 派生
+	if err != nil {
+		return "", err
+	}
+	dir := strings.TrimSpace(string(b))
+	if dir == "" || strings.Contains(dir, "..") {
+		return "", fmt.Errorf("audit: corrupt session marker %s", path)
+	}
+	return dir, nil
+}
diff --git a/backend/internal/audit/store.go b/backend/internal/audit/store.go
new file mode 100644
index 000000000..304be7c7c
--- /dev/null
+++ b/backend/internal/audit/store.go
@@ -0,0 +1,306 @@
+package audit
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// Store 管理归档根目录、会话目录映射、请求索引与压缩器。
+type Store struct {
+	cfg      Config
+	root     string
+	red      *redactor
+	sessions *sessionDirs
+	codec    *codec
+	pending  sync.WaitGroup
+	flushSem chan struct{}
+	closed   atomic.Bool
+	now      func() time.Time
+
+	// 统计（用于性能报告与健康检查）
+	stats Stats
+}
+
+// Stats 是归档写入的累计计数。
+type Stats struct {
+	Requests      atomic.Int64
+	BeginErrors   atomic.Int64
+	CloseErrors   atomic.Int64
+	RawBytes      atomic.Int64
+	DroppedWrites atomic.Int64
+	FlushBacklog  atomic.Int64
+}
+
+// NewStore 创建归档存储；根目录不存在时自动创建。
+func NewStore(cfg Config) (*Store, error) {
+	if strings.TrimSpace(cfg.RootDir) == "" {
+		cfg.RootDir = DefaultConfig().RootDir
+	}
+	root, err := filepath.Abs(cfg.RootDir)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.MkdirAll(root, 0o750); err != nil {
+		return nil, fmt.Errorf("audit: create root dir: %w", err)
+	}
+	c, err := newCodec(cfg.EncoderLevel)
+	if err != nil {
+		return nil, err
+	}
+	if cfg.MemoryBufferBytes <= 0 {
+		cfg.MemoryBufferBytes = DefaultConfig().MemoryBufferBytes
+	}
+	if len(cfg.SessionHeaders) == 0 {
+		cfg.SessionHeaders = DefaultSessionHeaders
+	}
+	if cfg.FlushWorkers <= 0 {
+		cfg.FlushWorkers = DefaultConfig().FlushWorkers
+	}
+	return &Store{
+		cfg:      cfg,
+		root:     root,
+		red:      newRedactor(cfg),
+		sessions: newSessionDirs(root, cfg.SessionCacheSize),
+		codec:    c,
+		flushSem: make(chan struct{}, cfg.FlushWorkers),
+		now:      time.Now,
+	}, nil
+}
+
+// Root 返回归档根目录的绝对路径。
+func (s *Store) Root() string { return s.root }
+
+// Config 返回生效配置。
+func (s *Store) Config() Config { return s.cfg }
+
+// StatsSnapshot 返回统计快照。
+func (s *Store) StatsSnapshot() map[string]int64 {
+	return map[string]int64{
+		"requests":       s.stats.Requests.Load(),
+		"begin_errors":   s.stats.BeginErrors.Load(),
+		"close_errors":   s.stats.CloseErrors.Load(),
+		"raw_bytes":      s.stats.RawBytes.Load(),
+		"dropped_writes": s.stats.DroppedWrites.Load(),
+		"flush_backlog":  s.stats.FlushBacklog.Load(),
+		"session_cache":  int64(s.sessions.len()),
+	}
+}
+
+// Close 停止接收新归档并等待已结束请求的压缩落盘完成。
+func (s *Store) Close(ctx context.Context) error {
+	if s == nil {
+		return nil
+	}
+	s.closed.Store(true)
+	done := make(chan struct{})
+	go func() {
+		s.pending.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+var refRE = regexp.MustCompile(`^\d{4}-\d{2}/\d{2}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}-\d{1,6}$`)
+
+// ValidRef 校验归档引用（相对根目录的基础路径，不含 kind 后缀）。
+func ValidRef(ref string) bool {
+	return refRE.MatchString(ref) && !strings.Contains(ref, "..")
+}
+
+// FilePath 返回某个归档引用下指定 kind 的文件绝对路径。
+func (s *Store) FilePath(ref, kind string) (string, error) {
+	if !ValidRef(ref) {
+		return "", fmt.Errorf("audit: invalid archive ref")
+	}
+	valid := false
+	for _, k := range Kinds {
+		valid = valid || k == kind
+	}
+	if !valid {
+		return "", fmt.Errorf("audit: invalid kind")
+	}
+	p := filepath.Join(s.root, filepath.FromSlash(ref)+"-"+kind+".zst")
+	if !strings.HasPrefix(p, s.root+string(filepath.Separator)) {
+		return "", fmt.Errorf("audit: invalid archive ref")
+	}
+	return p, nil
+}
+
+// Begin 为一个客户端请求创建归档器。
+//
+// 请求热路径上只解析会话目录（有界 LRU 命中为纯内存；未命中时读/建一次标记文件，
+// 保证“最先开始的请求”固定会话日期）；目录与四个文件的创建、索引追加全部推迟到后台
+// （请求结束后的落盘 goroutine，或大正文切换流式压缩时）。
+func (s *Store) Begin(requestID, session, sessionHeader string, now time.Time) (*Recorder, error) {
+	if s.closed.Load() {
+		return nil, errors.New("audit: store closed")
+	}
+	sessDir, err := s.sessions.Resolve(session, now)
+	if err != nil {
+		return nil, err
+	}
+	rec := &Recorder{
+		sessDir:       sessDir,
+		store:         s,
+		ID:            requestID,
+		Session:       session,
+		SessionHeader: sessionHeader,
+		Started:       now,
+		open:          make(map[*section]struct{}),
+	}
+	for i := range Kinds {
+		idx := i
+		rec.files[i] = newArchiveFile(func() (*os.File, error) {
+			files, err := rec.ensureFiles()
+			if err != nil {
+				return nil, err
+			}
+			return files[idx], nil
+		}, s.codec, s.cfg.MemoryBufferBytes)
+	}
+	s.pending.Add(1)
+	s.stats.Requests.Add(1)
+	return rec, nil
+}
+
+// ensureFiles 只执行一次：定位会话目录（固定首次日期），以 O_EXCL 创建四个文件
+// （{yyyy-MM}/{dd}/{session}/{requestId}-{n}-{kind}.zst，n 递增，重复请求 ID 不覆盖），
+// 并追加请求索引。
+func (r *Recorder) ensureFiles() ([4]*os.File, error) {
+	r.filesOnce.Do(func() {
+		r.filesRes, r.filesErr = r.store.createFiles(r)
+		if r.filesErr != nil {
+			r.store.stats.BeginErrors.Add(1)
+			slog.Warn("audit_archive_create_failed", "request_id", r.ID, "error", r.filesErr)
+		}
+	})
+	return r.filesRes, r.filesErr
+}
+
+func (s *Store) createFiles(r *Recorder) ([4]*os.File, error) {
+	var files [4]*os.File
+	sessDir := r.sessDir
+	absDir := filepath.Join(s.root, filepath.FromSlash(sessDir))
+	if err := os.MkdirAll(absDir, 0o750); err != nil {
+		return files, err
+	}
+	name := safeName(r.ID)
+	for n := 1; n <= 999999; n++ {
+		base := fmt.Sprintf("%s-%d", name, n)
+		f, err := os.OpenFile(filepath.Join(absDir, base+"-"+KindClientRequest+".zst"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o640)
+		if errors.Is(err, fs.ErrExist) {
+			continue
+		}
+		if err != nil {
+			return files, err
+		}
+		files[0] = f
+		for i, kind := range Kinds[1:] {
+			f, err := os.OpenFile(filepath.Join(absDir, base+"-"+kind+".zst"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o640)
+			if err != nil {
+				for _, opened := range files[:i+1] {
+					_ = opened.Close()
+				}
+				return [4]*os.File{}, err
+			}
+			files[i+1] = f
+		}
+		ref := sessDir + "/" + base
+		r.mu.Lock()
+		r.ref = ref
+		r.mu.Unlock()
+		s.appendIndex(r.ID, IndexEntry{Ref: ref, Time: r.Started, Via: "client_request_id", RequestID: r.ID, Session: r.Session})
+		return files, nil
+	}
+	return files, errors.New("audit: too many duplicate request ids")
+}
+
+// IndexEntry 是请求索引中的一行。索引按 ID 的 sha256 分桶，查找为 O(1) 文件读取。
+type IndexEntry struct {
+	Ref            string    `json:"ref"`
+	Time           time.Time `json:"t"`
+	Via            string    `json:"via"`
+	RequestID      string    `json:"request_id,omitempty"`
+	Session        string    `json:"session,omitempty"`
+	UsageRequestID string    `json:"usage_request_id,omitempty"`
+	UsageState     string    `json:"usage_state,omitempty"`
+	UsageError     string    `json:"usage_error,omitempty"`
+	APIKeyID       int64     `json:"api_key_id,omitempty"`
+	AccountID      int64     `json:"account_id,omitempty"`
+	UserID         int64     `json:"user_id,omitempty"`
+}
+
+func (s *Store) indexPath(key string) string {
+	h := hashKey(key)
+	return filepath.Join(s.root, ".index", h[:2], h[2:4], h+".idx")
+}
+
+func (s *Store) appendIndex(key string, e IndexEntry) {
+	key = strings.TrimSpace(key)
+	if key == "" {
+		return
+	}
+	p := s.indexPath(key)
+	if err := os.MkdirAll(filepath.Dir(p), 0o750); err != nil {
+		slog.Warn("audit_index_mkdir_failed", "error", err)
+		return
+	}
+	line, err := json.Marshal(e)
+	if err != nil {
+		return
+	}
+	line = append(line, '\n')
+	f, err := os.OpenFile(p, os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0o640) //nolint:gosec // 路径由 sha256 派生
+	if err != nil {
+		slog.Warn("audit_index_open_failed", "error", err)
+		return
+	}
+	// 单次 write + O_APPEND：多写者并发追加时行不会交错。
+	if _, err := f.Write(line); err != nil {
+		slog.Warn("audit_index_write_failed", "error", err)
+	}
+	_ = f.Close()
+}
+
+// Lookup 返回某个 ID（客户端请求 ID 或用量 request_id）对应的全部索引行。
+func (s *Store) Lookup(key string) ([]IndexEntry, error) {
+	key = strings.TrimSpace(key)
+	if key == "" {
+		return nil, nil
+	}
+	f, err := os.Open(s.indexPath(key))
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = f.Close() }()
+	var out []IndexEntry
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 0, 4096), 1<<20)
+	for sc.Scan() {
+		var e IndexEntry
+		if json.Unmarshal(sc.Bytes(), &e) == nil && ValidRef(e.Ref) {
+			out = append(out, e)
+		}
+	}
+	return out, sc.Err()
+}
diff --git a/backend/internal/audit/trace.go b/backend/internal/audit/trace.go
new file mode 100644
index 000000000..105115229
--- /dev/null
+++ b/backend/internal/audit/trace.go
@@ -0,0 +1,41 @@
+package audit
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"net/http"
+
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+// TraceInfo 是归档使用的 trace/span 关联信息。
+type TraceInfo struct {
+	TraceID      string `json:"trace_id"`
+	SpanID       string `json:"span_id"`
+	ParentSpanID string `json:"parent_span_id,omitempty"`
+	// Source: otel_context（进程内已有 span）/ traceparent（客户端 W3C 头）/ generated
+	Source string `json:"source"`
+}
+
+// traceFromRequest 优先复用 OTel 上下文中的 span，其次解析 W3C traceparent，
+// 均无时生成新的 trace id。只读取，不向上游注入任何头，因此不改变真实调用。
+func traceFromRequest(ctx context.Context, h http.Header) TraceInfo {
+	if sc := trace.SpanContextFromContext(ctx); sc.IsValid() {
+		return TraceInfo{TraceID: sc.TraceID().String(), ParentSpanID: sc.SpanID().String(), SpanID: newSpanID(), Source: "otel_context"}
+	}
+	extracted := propagation.TraceContext{}.Extract(context.Background(), propagation.HeaderCarrier(h))
+	if sc := trace.SpanContextFromContext(extracted); sc.IsValid() {
+		return TraceInfo{TraceID: sc.TraceID().String(), ParentSpanID: sc.SpanID().String(), SpanID: newSpanID(), Source: "traceparent"}
+	}
+	var tid [16]byte
+	_, _ = rand.Read(tid[:])
+	return TraceInfo{TraceID: hex.EncodeToString(tid[:]), SpanID: newSpanID(), Source: "generated"}
+}
+
+func newSpanID() string {
+	var b [8]byte
+	_, _ = rand.Read(b[:])
+	return hex.EncodeToString(b[:])
+}
diff --git a/backend/internal/audit/transport.go b/backend/internal/audit/transport.go
new file mode 100644
index 000000000..648447c90
--- /dev/null
+++ b/backend/internal/audit/transport.go
@@ -0,0 +1,297 @@
+package audit
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+)
+
+// AttemptInfo 是调用方已知的调度信息。
+type AttemptInfo struct {
+	AccountID int64
+	// Proxy 仅记录是否经代理及代理方案，不记录凭据。
+	Proxy string
+	// Via 标识接入点（http_upstream / http_upstream_tls / openai_ws_dial）。
+	Via string
+}
+
+// roundTripper 在真实传输之上旁路记录实际上游请求与上游响应：
+// 记录的是交给 Transport 的最终请求（协议转换、UA 改写、默认头、账户切换之后），
+// 以及 Transport 返回的原始响应字节（Content-Encoding 保持原样，展示时再解码）。
+type roundTripper struct {
+	base http.RoundTripper
+	info AttemptInfo
+}
+
+// WrapClient 返回浅拷贝的 client，其 Transport 增加归档旁路。
+// 没有归档器的请求（例如后台任务）原样透传。
+func WrapClient(client *http.Client, info AttemptInfo) *http.Client {
+	if client == nil || Default() == nil {
+		return client
+	}
+	clone := *client
+	base := clone.Transport
+	if base == nil {
+		base = http.DefaultTransport
+	}
+	if rt, ok := base.(*roundTripper); ok {
+		base = rt.base
+	}
+	clone.Transport = &roundTripper{base: base, info: info}
+	return &clone
+}
+
+// RedactProxy 只保留代理方案与主机，去掉用户名密码。
+func RedactProxy(proxy string) string {
+	proxy = strings.TrimSpace(proxy)
+	if proxy == "" {
+		return ""
+	}
+	if i := strings.Index(proxy, "@"); i >= 0 {
+		scheme := ""
+		if j := strings.Index(proxy, "://"); j >= 0 && j < i {
+			scheme = proxy[:j+3]
+		}
+		return scheme + "***@" + proxy[i+1:]
+	}
+	return proxy
+}
+
+func (t *roundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	rec := FromContext(req.Context())
+	if rec == nil || rec.Finished() {
+		return t.base.RoundTrip(req)
+	}
+	red := rec.store.red
+	seq := rec.NextAttempt()
+	spanID := newSpanID()
+	transport := "http"
+	if strings.EqualFold(req.Header.Get("Upgrade"), "websocket") {
+		transport = "websocket"
+	}
+	meta := map[string]any{
+		"attempt":        seq,
+		"account_id":     t.info.AccountID,
+		"via":            t.info.Via,
+		"proxy":          RedactProxy(t.info.Proxy),
+		"trace_id":       rec.TraceID,
+		"span_id":        spanID,
+		"parent_span_id": rec.SpanID,
+		"content_length": req.ContentLength,
+	}
+	// Transport 隐式行为：未显式声明 Accept-Encoding 时，net/http 会自动加 gzip 并透明解压。
+	if req.Header.Get("Accept-Encoding") == "" && transport == "http" {
+		meta["transport_implicit_accept_encoding"] = "gzip (net/http default, transparently decoded)"
+	}
+	host := req.Host
+	if host == "" && req.URL != nil {
+		host = req.URL.Host
+	}
+	reqSec := rec.startSection(KindUpstreamRequest, SectionHeader{
+		Seq:       seq,
+		Method:    req.Method,
+		URL:       red.URL(req.URL),
+		Proto:     req.Proto,
+		Host:      host,
+		Header:    red.Header(req.Header),
+		Transport: transport,
+		Meta:      meta,
+	})
+
+	out := req
+	var tb *upstreamBody
+	if req.Body != nil && req.Body != http.NoBody {
+		out = req.Clone(req.Context())
+		tb = &upstreamBody{ReadCloser: req.Body, sec: reqSec}
+		out.Body = tb
+		if req.GetBody != nil {
+			orig := req.GetBody
+			var replayMu sync.Mutex
+			current := tb
+			out.GetBody = func() (io.ReadCloser, error) {
+				// Transport 重放请求体（连接复用失败 / 307 等）：前一段标记为未完成，开启新段。
+				body, err := orig()
+				if err != nil {
+					return body, err
+				}
+				replayMu.Lock()
+				defer replayMu.Unlock()
+				current.replaced()
+				sec := rec.startSection(KindUpstreamRequest, SectionHeader{Seq: seq, Replay: true, Method: req.Method, URL: red.URL(req.URL), Header: red.Header(req.Header), Transport: transport, Meta: map[string]any{"attempt": seq, "span_id": spanID}})
+				current = &upstreamBody{ReadCloser: body, sec: sec}
+				return current, nil
+			}
+		}
+	} else {
+		reqSec.end(true, "", nil)
+	}
+
+	resp, err := t.base.RoundTrip(out)
+	if err != nil {
+		rec.startSection(KindUpstreamResponse, SectionHeader{Seq: seq, Meta: map[string]any{"attempt": seq, "account_id": t.info.AccountID, "span_id": spanID}}).
+			end(false, "transport error: "+err.Error(), nil)
+		return resp, err
+	}
+
+	respMeta := map[string]any{
+		"attempt":    seq,
+		"account_id": t.info.AccountID,
+		"span_id":    spanID,
+	}
+	if resp.Uncompressed {
+		respMeta["transport_decoded"] = true
+	}
+	respTransport := "http"
+	if strings.HasPrefix(strings.ToLower(resp.Header.Get("Content-Type")), "text/event-stream") {
+		respTransport = "sse"
+	}
+	if resp.StatusCode == http.StatusSwitchingProtocols {
+		respTransport = "websocket"
+	}
+	respSec := rec.startSection(KindUpstreamResponse, SectionHeader{
+		Seq:       seq,
+		Status:    resp.StatusCode,
+		Proto:     resp.Proto,
+		Header:    red.Header(resp.Header),
+		Transport: respTransport,
+		Meta:      respMeta,
+	})
+
+	if resp.StatusCode == http.StatusSwitchingProtocols {
+		// 升级后的连接由 WS 客户端以消息粒度记录（见 WSTap），这里不包装可写 Body。
+		respSec.end(true, "", map[string]any{"upgraded": true})
+		rec.mu.Lock()
+		rec.lastWS = int32(seq) //nolint:gosec // bounded
+		rec.mu.Unlock()
+		return resp, nil
+	}
+	if resp.Body == nil || resp.Body == http.NoBody {
+		respSec.end(true, "", nil)
+		return resp, nil
+	}
+	resp.Body = &responseBody{ReadCloser: resp.Body, sec: respSec}
+	return resp, nil
+}
+
+// upstreamBody 复制 Transport 实际读取并发送的请求体字节。
+type upstreamBody struct {
+	io.ReadCloser
+	sec  *section
+	mu   sync.Mutex
+	eof  bool
+	err  error
+	done bool
+}
+
+func (b *upstreamBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if n > 0 {
+		b.sec.body(p[:n])
+	}
+	if err != nil {
+		b.mu.Lock()
+		if errors.Is(err, io.EOF) {
+			b.eof = true
+		} else if b.err == nil {
+			b.err = err
+		}
+		b.mu.Unlock()
+		if errors.Is(err, io.EOF) {
+			b.finish()
+		}
+	}
+	return n, err
+}
+
+func (b *upstreamBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.finish()
+	return err
+}
+
+func (b *upstreamBody) finish() {
+	b.mu.Lock()
+	if b.done {
+		b.mu.Unlock()
+		return
+	}
+	b.done = true
+	eof, rerr := b.eof, b.err
+	b.mu.Unlock()
+	switch {
+	case eof:
+		b.sec.end(true, "", nil)
+	case rerr != nil:
+		b.sec.end(false, "read error: "+rerr.Error(), nil)
+	default:
+		b.sec.end(false, "request body closed before EOF", nil)
+	}
+}
+
+func (b *upstreamBody) replaced() {
+	b.mu.Lock()
+	if b.done {
+		b.mu.Unlock()
+		return
+	}
+	b.done = true
+	b.mu.Unlock()
+	b.sec.end(false, "request body replayed by transport", nil)
+}
+
+// responseBody 复制业务实际读取到的上游响应字节。
+type responseBody struct {
+	io.ReadCloser
+	sec  *section
+	mu   sync.Mutex
+	eof  bool
+	err  error
+	done bool
+}
+
+func (b *responseBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if n > 0 {
+		b.sec.body(p[:n])
+	}
+	if err != nil {
+		b.mu.Lock()
+		if errors.Is(err, io.EOF) {
+			b.eof = true
+		} else if b.err == nil {
+			b.err = err
+		}
+		b.mu.Unlock()
+		if errors.Is(err, io.EOF) {
+			b.finish()
+		}
+	}
+	return n, err
+}
+
+func (b *responseBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.finish()
+	return err
+}
+
+func (b *responseBody) finish() {
+	b.mu.Lock()
+	if b.done {
+		b.mu.Unlock()
+		return
+	}
+	b.done = true
+	eof, rerr := b.eof, b.err
+	b.mu.Unlock()
+	switch {
+	case eof:
+		b.sec.end(true, "", nil)
+	case rerr != nil:
+		b.sec.end(false, "read error: "+rerr.Error(), nil)
+	default:
+		b.sec.end(false, "response body closed before EOF (consumer stopped reading)", nil)
+	}
+}
diff --git a/backend/internal/audit/usage.go b/backend/internal/audit/usage.go
new file mode 100644
index 000000000..4cb008733
--- /dev/null
+++ b/backend/internal/audit/usage.go
@@ -0,0 +1,91 @@
+package audit
+
+import (
+	"context"
+	"strings"
+	"time"
+)
+
+// 用量回调状态。注意：回调只说明“仓储层调用已返回”，不代表事务已提交；
+// 展示层以数据库中实际存在的 usage_logs 行为准。
+const (
+	UsageStateWriteReturned = "write_returned"        // 非事务写入返回成功（仍以数据库查询为准）
+	UsageStateDuplicate     = "duplicate_ignored"     // ON CONFLICT 未插入
+	UsageStatePendingTx     = "pending_tx_not_proven" // 处于外部事务内，提交与否未知
+	UsageStateFailed        = "write_failed"
+)
+
+// UsageEvent 是仓储层写用量后的回调参数。
+type UsageEvent struct {
+	RequestID string
+	APIKeyID  int64
+	AccountID int64
+	UserID    int64
+	Inserted  bool
+	InTx      bool
+	Err       error
+}
+
+// OnUsage 把用量 request_id 关联到当前请求的归档（追加索引 + 附注）。
+// context 中没有归档器（后台补记、异步任务）时直接忽略。
+func OnUsage(ctx context.Context, ev UsageEvent) {
+	rec := FromContext(ctx)
+	if rec == nil || strings.TrimSpace(ev.RequestID) == "" {
+		return
+	}
+	state := UsageStateWriteReturned
+	errText := ""
+	switch {
+	case ev.Err != nil:
+		state, errText = UsageStateFailed, ev.Err.Error()
+	case ev.InTx:
+		state = UsageStatePendingTx
+	case !ev.Inserted:
+		state = UsageStateDuplicate
+	}
+	entry := IndexEntry{
+		Time:           time.Now(),
+		Via:            "usage_callback",
+		RequestID:      rec.ID,
+		Session:        rec.Session,
+		UsageRequestID: ev.RequestID,
+		UsageState:     state,
+		UsageError:     errText,
+		APIKeyID:       ev.APIKeyID,
+		AccountID:      ev.AccountID,
+		UserID:         ev.UserID,
+	}
+	// 请求进行中：暂存到归档器，由落盘 goroutine 写索引（不在请求路径上做文件 I/O）；
+	// 请求已结束（异步计费回调）：后台补写。
+	rec.mu.Lock()
+	if !rec.finished.Load() {
+		rec.usage = append(rec.usage, entry)
+		rec.mu.Unlock()
+	} else {
+		rec.mu.Unlock()
+		rec.store.pending.Add(1)
+		go func() {
+			defer rec.store.pending.Done()
+			if _, err := rec.ensureFiles(); err == nil {
+				entry.Ref = rec.ArchiveRef()
+				rec.store.writeUsageIndex(entry)
+			}
+		}()
+	}
+	rec.Note(KindClientResponse, 0, map[string]any{
+		"type":             "usage_callback",
+		"usage_request_id": ev.RequestID,
+		"usage_state":      state,
+		"usage_error":      errText,
+		"api_key_id":       ev.APIKeyID,
+		"account_id":       ev.AccountID,
+	})
+}
+
+// writeUsageIndex 用量 request_id 与客户端请求 ID 不同（client:/local:/web_search: 等前缀）时单独建索引。
+func (s *Store) writeUsageIndex(e IndexEntry) {
+	if e.UsageRequestID != e.RequestID {
+		s.appendIndex(e.UsageRequestID, e)
+	}
+	s.appendIndex(e.RequestID, e)
+}
diff --git a/backend/internal/audit/ws.go b/backend/internal/audit/ws.go
new file mode 100644
index 000000000..96d241b66
--- /dev/null
+++ b/backend/internal/audit/ws.go
@@ -0,0 +1,112 @@
+package audit
+
+import (
+	"context"
+	"sync"
+)
+
+// WSTap 以消息粒度记录上游 WebSocket 连接的收发（已解除 permessage-deflate）。
+//
+// 上游 WS 连接可能被连接池复用、由常驻读循环以后台 context 读取，因此：
+//   - 带归档器的 context 调用时，连接绑定到该请求（若与上次不同则切换并开启新段）；
+//   - 不带归档器的 context（读循环）沿用最近绑定的请求。
+//
+// 握手请求/响应头由 RoundTripper 在建连时记录；复用连接在新请求中以
+// ws_reused 段标注原建连请求。
+type WSTap struct {
+	mu      sync.Mutex
+	rec     *Recorder
+	seq     int
+	out     *section
+	in      *section
+	dialReq string
+	dialSeq int
+}
+
+// NewWSTap 在建连成功后创建 Tap；ctx 中无归档器时仍返回可用的 Tap（等待后续绑定）。
+func NewWSTap(ctx context.Context) *WSTap {
+	if Default() == nil {
+		return nil
+	}
+	t := &WSTap{}
+	if rec := FromContext(ctx); rec != nil {
+		rec.mu.Lock()
+		t.dialSeq = int(rec.lastWS)
+		rec.lastWS = 0
+		rec.mu.Unlock()
+		t.dialReq = rec.ID
+		t.bindLocked(rec, t.dialSeq, false)
+	}
+	return t
+}
+
+func (t *WSTap) bindLocked(rec *Recorder, seq int, reused bool) {
+	if t.rec != nil {
+		t.out.end(true, "", map[string]any{"ws_released": true})
+		t.in.end(true, "", map[string]any{"ws_released": true})
+	}
+	t.rec, t.out, t.in = rec, nil, nil
+	if rec == nil || rec.Finished() {
+		t.rec = nil
+		return
+	}
+	if seq <= 0 {
+		seq = rec.NextAttempt()
+	}
+	t.seq = seq
+	meta := map[string]any{"attempt": seq, "ws_messages": true}
+	if reused {
+		meta["ws_reused"] = true
+		meta["dial_request_id"] = t.dialReq
+	}
+	t.out = rec.startSection(KindUpstreamRequest, SectionHeader{Seq: seq, Transport: "websocket", Meta: meta})
+	t.in = rec.startSection(KindUpstreamResponse, SectionHeader{Seq: seq, Transport: "websocket", Meta: meta})
+}
+
+func (t *WSTap) target(ctx context.Context, outbound bool) *section {
+	if t == nil {
+		return nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if rec := FromContext(ctx); rec != nil && rec != t.rec && !rec.Finished() {
+		t.bindLocked(rec, 0, true)
+	}
+	if t.rec == nil || t.rec.Finished() {
+		return nil
+	}
+	if outbound {
+		return t.out
+	}
+	return t.in
+}
+
+// Sent 记录发往上游的一条消息。
+func (t *WSTap) Sent(ctx context.Context, op byte, data []byte) {
+	if s := t.target(ctx, true); s != nil {
+		s.message(op, data)
+	}
+}
+
+// Received 记录从上游收到的一条消息。
+func (t *WSTap) Received(ctx context.Context, op byte, data []byte) {
+	if s := t.target(ctx, false); s != nil {
+		s.message(op, data)
+	}
+}
+
+// Closed 记录连接关闭（错误原因写入两段的结束信息）。
+func (t *WSTap) Closed(reason string) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.rec == nil {
+		return
+	}
+	complete := reason == ""
+	t.out.end(complete, reason, nil)
+	t.in.end(complete, reason, nil)
+	t.rec = nil
+}
diff --git a/backend/internal/audit/wsraw.go b/backend/internal/audit/wsraw.go
new file mode 100644
index 000000000..f75577ac6
--- /dev/null
+++ b/backend/internal/audit/wsraw.go
@@ -0,0 +1,184 @@
+package audit
+
+import (
+	"bytes"
+	"compress/flate"
+	"encoding/binary"
+	"errors"
+	"io"
+	"strings"
+)
+
+// wsDeflate 描述协商得到的 permessage-deflate 参数（RFC 7692）。
+type wsDeflate struct {
+	enabled                 bool
+	serverNoContextTakeover bool
+	clientNoContextTakeover bool
+}
+
+func parseWSExtensions(v string) wsDeflate {
+	var d wsDeflate
+	for _, ext := range strings.Split(v, ",") {
+		params := strings.Split(ext, ";")
+		if strings.TrimSpace(params[0]) != "permessage-deflate" {
+			continue
+		}
+		d.enabled = true
+		for _, p := range params[1:] {
+			switch strings.TrimSpace(strings.SplitN(p, "=", 2)[0]) {
+			case "server_no_context_takeover":
+				d.serverNoContextTakeover = true
+			case "client_no_context_takeover":
+				d.clientNoContextTakeover = true
+			}
+		}
+	}
+	return d
+}
+
+// inflater 以“上一条消息末尾 32KB 明文”为预置字典解压每条消息，
+// 等价于 context takeover 下的滑动窗口，展示阶段离线即可还原。
+type inflater struct {
+	takeover bool
+	window   []byte
+}
+
+func (f *inflater) inflate(payload []byte) ([]byte, error) {
+	in := append(append([]byte(nil), payload...), 0x00, 0x00, 0xff, 0xff)
+	var dict []byte
+	if f.takeover {
+		dict = f.window
+	}
+	r := flate.NewReaderDict(bytes.NewReader(in), dict)
+	out, err := io.ReadAll(r)
+	_ = r.Close()
+	if err != nil && !errors.Is(err, io.ErrUnexpectedEOF) {
+		return out, err
+	}
+	if f.takeover {
+		f.window = append(f.window, out...)
+		if len(f.window) > 32<<10 {
+			f.window = append([]byte(nil), f.window[len(f.window)-(32<<10):]...)
+		}
+	}
+	return out, nil
+}
+
+// parseWSFrames 把劫持连接上的原始字节解析为消息（处理掩码、分片、压缩）。
+// dir 为展示方向标签；masked 表示客户端→服务端方向。
+func parseWSFrames(raw []byte, dir string, defl wsDeflate, clientToServer bool, limit int) ([]WSMessage, bool) {
+	var msgs []WSMessage
+	takeover := defl.enabled
+	if clientToServer && defl.clientNoContextTakeover {
+		takeover = false
+	}
+	if !clientToServer && defl.serverNoContextTakeover {
+		takeover = false
+	}
+	inf := &inflater{takeover: takeover}
+
+	var (
+		msgOp         byte
+		msgCompressed bool
+		msgBuf        []byte
+		inMessage     bool
+	)
+	pos := 0
+	for pos < len(raw) {
+		if len(msgs) >= limit {
+			return msgs, true
+		}
+		if len(raw)-pos < 2 {
+			return msgs, true
+		}
+		b0, b1 := raw[pos], raw[pos+1]
+		fin := b0&0x80 != 0
+		rsv1 := b0&0x40 != 0
+		op := b0 & 0x0f
+		masked := b1&0x80 != 0
+		plen := uint64(b1 & 0x7f)
+		hdr := 2
+		switch plen {
+		case 126:
+			if len(raw)-pos < 4 {
+				return msgs, true
+			}
+			plen = uint64(binary.BigEndian.Uint16(raw[pos+2:]))
+			hdr = 4
+		case 127:
+			if len(raw)-pos < 10 {
+				return msgs, true
+			}
+			plen = binary.BigEndian.Uint64(raw[pos+2:])
+			hdr = 10
+		}
+		var key []byte
+		if masked {
+			if len(raw)-pos < hdr+4 {
+				return msgs, true
+			}
+			key = raw[pos+hdr : pos+hdr+4]
+			hdr += 4
+		}
+		if plen > uint64(len(raw)-pos-hdr) {
+			// 帧不完整（连接中断或展示截断）。
+			return msgs, true
+		}
+		payload := append([]byte(nil), raw[pos+hdr:pos+hdr+int(plen)]...) //nolint:gosec // 已校验边界
+		if masked {
+			for i := range payload {
+				payload[i] ^= key[i%4]
+			}
+		}
+		pos += hdr + int(plen) //nolint:gosec // 已校验边界
+
+		if op >= 8 { // 控制帧：可插在分片之间
+			m := WSMessage{Dir: dir, Op: opName(op), Size: len(payload)}
+			if op == WSOpClose && len(payload) >= 2 {
+				m.Text = strings.TrimSpace(strings.Join([]string{itoa(int(binary.BigEndian.Uint16(payload))), string(payload[2:])}, " "))
+			} else {
+				setPayload(&m.Text, &m.Base64, payload, 4096)
+			}
+			msgs = append(msgs, m)
+			continue
+		}
+		if op != 0 {
+			msgOp, msgCompressed, msgBuf, inMessage = op, rsv1 && defl.enabled, payload, true
+		} else if inMessage {
+			msgBuf = append(msgBuf, payload...)
+		} else {
+			continue
+		}
+		if !fin {
+			continue
+		}
+		inMessage = false
+		m := WSMessage{Dir: dir, Op: opName(msgOp), Compressed: msgCompressed}
+		data := msgBuf
+		if msgCompressed {
+			out, err := inf.inflate(msgBuf)
+			if err != nil {
+				m.Error = "inflate: " + err.Error()
+			}
+			data = out
+		}
+		m.Size = len(data)
+		setPayload(&m.Text, &m.Base64, data, 256<<10)
+		msgs = append(msgs, m)
+	}
+	return msgs, false
+}
+
+func itoa(v int) string {
+	if v == 0 {
+		return "0"
+	}
+	var b [12]byte
+	i := len(b)
+	for v > 0 {
+		i--
+		b[i] = byte('0' + v%10)
+		v /= 10
+	}
+	return string(b[i:])
+}
